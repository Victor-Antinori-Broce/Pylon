{
  "name": "@kitsuden/api",
  "version": "0.9.0-beta",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --external sharp --external @node-rs/argon2",
    "typecheck": "tsc --noEmit",
    "start": "bun run dist/index.js",
    "mcp-server": "bun run src/mcp-server.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:migrate:status": "bun run scripts/migrate.ts --status",
    "db:migrate:dry": "bun run scripts/migrate.ts --dry-run",
    "db:migrate:baseline": "bun run scripts/migrate.ts --baseline",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts",
    "seed:mcp": "bun run scripts/seed-mcp-test.ts",
    "test": "bun test",
    "test:unit": "bun test src/tests-unit/",
    "test:watch": "bun test --watch",
    "test:auth": "bun test src/tests/auth.test.ts",
    "test:datasets": "bun test src/tests/datasets.test.ts",
    "test:modules": "bun test src/tests/modules.test.ts",
    "test:rls": "bun test src/tests/rls.test.ts",
    "test:coverage": "bun test --coverage",
    "test:realtime": "bun run src/tests/realtime.test.ts",
    "test:db:up": "powershell -ExecutionPolicy Bypass -File ../../scripts/test-db-up.ps1",
    "test:db:down": "powershell -ExecutionPolicy Bypass -File ../../scripts/test-db-down.ps1",
    "test:all": "pnpm test:db:up && bun test src/tests/ && pnpm test:db:down",
    "test:memory": "cross-env KITSUDEN_TEST_DB=memory bun test",
    "auth:migrate": "bun run scripts/migrate-api-keys-to-agents.ts",
    "db:rls": "bun run scripts/apply-rls.ts",
    "db:verify:rls": "bun run scripts/verify-rls.ts",
    "db:backup": "bun run scripts/backup.ts",
    "db:backup:list": "bun run scripts/backup.ts --list",
    "db:restore": "bun run scripts/backup.ts --restore"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@asteasolutions/zod-to-openapi": "^5.5.0",
    "@aws-sdk/client-s3": "^3.990.0",
    "@aws-sdk/s3-request-presigner": "^3.995.0",
    "@electric-sql/pglite": "^0.5.4",
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-openapi": "^0.2.0",
    "@hono/zod-validator": "^0.4.3",
    "@kitsuden/engine": "workspace:*",
    "@kitsuden/mcp-server": "workspace:^",
    "@kitsuden/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.5.0",
    "@node-rs/argon2": "^2.0.2",
    "better-auth": "~1.6.31",
    "bullmq": "^5.0.0",
    "croner": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.9.0",
    "graphql-type-json": "^0.3.2",
    "hono": "^4.12.3",
    "hono-rate-limiter": "^0.4.0",
    "mysql2": "^3.18.0",
    "nodemailer": "^6.9.0",
    "ollama": "^0.6.3",
    "openai": "^6.46.0",
    "openapi3-ts": "^4.5.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "pino": "^9.0.0",
    "redis": "^5.11.0",
    "sharp": "^0.34.5",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/nodemailer": "^6.4.0",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.9",
    "pg-mem": "^3.0.14",
    "typescript": "^5.9.3"
  }
}
