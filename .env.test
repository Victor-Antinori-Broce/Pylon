# ═══════════════════════════════════════════════════════════════════════════
# Kitsuden — Environment for TESTS
#
# This file is loaded automatically when NODE_ENV=test.
# It points to the dedicated PostgreSQL test database (port 5434).
#
# To use an in-memory database instead (pg-mem), set:
#   KITSUDEN_TEST_DB=memory
#
# Quick start:
#   pnpm test:db:up     # Start PostgreSQL test container
#   pnpm test           # Run tests
#   pnpm test:db:down   # Stop test container
# ═══════════════════════════════════════════════════════════════════════════

# --- Test PostgreSQL (used by docker-compose.test.yml) ---
POSTGRES_USER=kitsuden
POSTGRES_PASSWORD=kitsuden_test_secure_change_me
POSTGRES_DB=kitsuden_test
POSTGRES_PORT=5434

# Application connection string (must match the values above)
# Its own database: the English core's sessions migrate the shared kitsuden_test
DATABASE_URL=postgres://kitsuden:kitsuden_test_secure_change_me@localhost:5434/kitsuden_test_cms

REDIS_URL=redis://localhost:6380
PORT=3001
API_URL=http://localhost:3001
ADMIN_URL=http://localhost:5173

# Test database mode:
#   postgres  → Use real PostgreSQL (default, recommended)
#   memory    → Use pg-mem in-memory database (faster setup, less compatible)
KITSUDEN_TEST_DB=postgres

# Test-only values. Before 2026-11-08 the bun suites read these from apps/api/.env,
# which is PRODUCTION on the owner's machine (secret, URLs and object storage).
# S3 is left unset on purpose: tests must never write to the production store.
BETTER_AUTH_SECRET=kitsuden-test-only-auth-secret-never-used-in-production
BETTER_AUTH_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4321
