# ═══════════════════════════════════════════════════════════════════════════
# GremiusCMS — Environment for TESTS
#
# This file is loaded automatically when NODE_ENV=test.
# It points to the dedicated PostgreSQL test database (port 5433).
#
# To use an in-memory database instead (pg-mem), set:
#   GREMIUS_TEST_DB=memory
#
# Quick start:
#   pnpm test:db:up     # Start PostgreSQL test container
#   pnpm test           # Run tests
#   pnpm test:db:down   # Stop test container
# ═══════════════════════════════════════════════════════════════════════════

DATABASE_URL=postgres://gremius:gremius_test_2025@localhost:5433/gremius_test
REDIS_URL=redis://localhost:6380
PORT=3001
API_URL=http://localhost:3001
ADMIN_URL=http://localhost:5173

# Test database mode:
#   postgres  → Use real PostgreSQL (default, recommended)
#   memory    → Use pg-mem in-memory database (faster setup, less compatible)
GREMIUS_TEST_DB=postgres
