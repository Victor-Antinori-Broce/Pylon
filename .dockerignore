# ===================================================================
# Kitsuden .dockerignore
# Excludes files not needed in Docker build context
# ===================================================================

# Dependencies (reinstalled inside Docker)
**/node_modules

# Build outputs (rebuilt inside Docker)
**/dist
**/build
**/.astro
**/.next
**/.turbo
**/.svelte-kit

# Git
.git
.gitattributes

# Environment files (secrets must be passed via env vars / compose)
.env
.env.local
.env.*.local
apps/api/.env
packages/admin/.env
.env.test

# Logs
*.log
apps/api/api.log
apps/api/api.err

# OS files
.DS_Store
Thumbs.db

# Test artifacts
playwright-report
test-results
pw_mcp_output.txt
tests.json

# IDE / Editor
.vscode
.claude

# Build diagnostics (not needed in image)
build-diag*.txt
progress.txt
kitsuden_progress.txt

# Legacy / experimental folders
_legacy*

# Documentation / analysis markdown (not runtime)
AI_MEMORIES_ANALYSIS.md
AI_MEMORIES_COMPLETION.md
analisis*.md
ANALISIS_*.md
ARCHITECTURE*.md
AUDITORIA_*.md
CALCULATED_FIELDS_MIGRATION.md
CAMBIOS_REALIZADOS.md
CHANGELOG.md
CODE_QUALITY.md
CONFIGURATION_AUDIT.md
DATASETS_*.md
DEUDA_TECNICA.md
DI_MIGRATION_REPORT.md
DOCKER-SETUP.md
DOCKER_BUILD_VERIFICATION_REPORT.md
ENDPOINT_*.md
ENGINE_CORE_INTEGRATION.md
FINAL_*.md
kitsuden.md
KON*.md
jiira.md
KCD.md
legacyrefactor.md
MCP_*.md
MCP_*.txt
MEJORAS_MCP.md
MIGRATION_ZERO_CONFIG.md
NPM_PACKAGE_AUDIT.md
PGVECTOR_SETUP.md
PLUGIN_SYSTEM.md
PORTS_AUDIT_REPORT.md
PROGRESS.md
PUBLISH_GUIDE.md
QUALITY_IMPROVEMENTS.md
START-GUIDE.md
STARTUP_GUIDE.md
TEST_*.md
TOON_PGVECTOR_AUDIT.md
VALIDATION_*.md
VERIFICATION_SUMMARY.md

# Specs / docs directories
specs
docs

# Compiled .js/.d.ts artifacts in source (should not be in git either)
apps/api/src/**/*.js
apps/api/src/**/*.d.ts
apps/api/src/**/*.js.map
apps/api/src/**/*.d.ts.map
apps/api/*.d.ts
apps/api/*.d.ts.map
apps/api/*.js
apps/api/*.js.map
apps/api/tsc-errors.txt
packages/admin/src/**/*.js
packages/admin/src/**/*.d.ts
packages/admin/src/**/*.js.map
packages/admin/src/**/*.d.ts.map

# Windows scripts
start.bat
scripts/dev-start-full.ps1
scripts/dev-start-simple.ps1

# Playwright config artifacts
playwright.config.d.ts
playwright.config.d.ts.map
playwright.config.js
playwright.config.js.map

gamedata/
apps/api/data/

# ── Añadido 2026-10-12 (preparación del VPS) ────────────────────────────
#
# `.env` en CUALQUIER carpeta, no solo en la raíz: el patrón `.env` de arriba
# solo casa con el de la raíz, y el `.env` del starter (direcciones de
# desarrollo, datos del titular) entraba entero en el contexto y en la
# compilación de la web. Los ejemplos sí entran.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Compilaciones locales de las webs (Dockerfile.web las rehace dentro)
**/dist-*

# Scripts sueltos y volcados de la raíz. Varios llevan la cadena de conexión
# de la base de PRODUCCIÓN en claro (auditoría 2026-10-04) y otros, contenido
# copiado de wikis ajenas: no deben llegar a ninguna imagen ni a su caché.
/scratch
/scratch-*
/scratch_*
/scrape_*
/scraped_aniimo_data
/check-db*.mjs
/check_wikis.cjs
/insert_weapon.cjs
/test-hono-route.mjs
/test-kon-mount.mjs
/fix_a11y.py
/mcp-agent.sql
/update-scopes.sql
/weapons_list.json
/api.json
/temp.html
/tmp-logs*
/x
/.cl.json
/coverage
/*.md
apps/api/coverage*.txt
apps/api/cov*.txt
apps/api/evals
**/tmp-*.html

# ── Añadido 2026-10-18 (separación producto público / sitios privados) ──
#
# La lista de arriba nombraba los scripts sueltos uno a uno y se escapaban los
# nuevos: `test_db.cjs`, `count_weapons.cjs`, `check_batch.cjs` o
# `verify_status.cjs` llevan la cadena de conexión de producción y entraban en
# el contexto de `COPY . .`. Ningún Dockerfile usa un .mjs/.cjs de la raíz
# salvo `start-all-webs.mjs` (Dockerfile.web), que se deja pasar.
/*.mjs
/*.cjs
!/start-all-webs.mjs
/*.html
/*.txt
/*.sql
/pending_batch.json
/tests.json
/.claude
/.kitsuden
**/.cl.json

# Informes, volcados y claves en cualquier carpeta
**/coverage
**/coverage*.txt
**/test-results*
**/check-output*.txt
**/*.dump
**/*.sql.gz
**/*.pem
**/*.key
**/*.p12

# Salidas de compilación sueltas y extractores .NET
**/tmp_build_*
**/obj
**/bin/Debug
**/bin/Release
apps/api/scripts/tmp

# Al final a propósito: `!**/.env.example` (arriba) vuelve a meter en el
# contexto los `.env.example` que hay DENTRO de carpetas excluidas
# (gamedata, worktrees de .claude). En .dockerignore gana la última regla.
.claude/**
gamedata/**
apps/api/data/**
**/__pycache__

# Kons (fase C): la imagen instala los de KITSUDEN_KONS desde el contexto
# adicional `kons` (docker/instalar-kons.mjs). Las COPIAS instaladas en el árbol
# de trabajo y su lista no entran: la imagen no depende de lo que haya en la
# carpeta de quien construye. packages/kons/package.json sí entra (es la raíz
# de la carpeta de instalación y su marcador).
packages/kons/kon-*
kitsuden.kons.json
