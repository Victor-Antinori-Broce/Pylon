.eslintcache
.stylelintcache

# ── Compiled .ts artifacts in source directories ──
# These MUST NOT be tracked — they cause SvelteKit "Multiple layout module"
# crashes and pollute the source tree.

# Global: map files are always compiled
**/*.js.map
**/*.d.ts.map

# Apps
apps/admin/src/**/*.js
apps/admin/src/**/*.d.ts
apps/admin/.svelte-kit/
apps/api/src/**/*.js
apps/api/src/**/*.d.ts
apps/api/*.js
apps/api/*.d.ts
apps/api/scripts/*.js
apps/api/scripts/*.d.ts
apps/api/migrations/*.js
apps/api/migrations/*.d.ts
apps/api/drizzle/*.js
apps/api/drizzle/*.d.ts

# Packages
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/*.js
packages/*/*.d.ts
packages/admin/.svelte-kit/

# Tests & Scripts
tests/**/*.js
tests/**/*.d.ts
scripts/*.js
scripts/*.d.ts

# Root configs
playwright.config.js
playwright.config.d.ts

# Keep .svelte.ts files (they are source, not compiled)
!apps/admin/src/**/*.svelte.ts
!apps/admin/src/**/*.svelte.js
!packages/admin/src/**/*.svelte.ts
!packages/admin/src/**/*.svelte.js

# Keep legitimate config files
!**/postcss.config.js
!**/tailwind.config.js
!**/svelte.config.js
!**/vite.config.js
!**/vitest.config.js
!**/playwright.config.ts
!**/tsup.config.ts
!**/drizzle.config.ts
!**/svelte.config.ts

# CLI test app (generated, should not be tracked)
packages/cli/test-vibecoder-app/

# Keep CLI binaries and templates
!packages/cli/bin/*.js
!packages/cli/templates/**/*.js
!packages/cli/templates/**/*.d.ts

# Kons compiled artifacts (in kon root dirs)
packages/kons/*/*.js
packages/kons/*/*.d.ts
packages/kons/*/src/**/*.js
packages/kons/*/src/**/*.d.ts
packages/kons/*/tests/*.js
packages/kons/*/tests/*.d.ts
packages/kons/*/services/*.js
packages/kons/*/services/*.d.ts

# Starters compiled artifacts
packages/starters/*/*.js
packages/starters/*/*.d.ts
packages/starters/**/*.js
packages/starters/**/*.d.ts

# Tests compiled artifacts
tests/**/*.js
tests/**/*.d.ts

# Keep Django static files
!capacitaciones_app/static/**/*.js

# ── Temporary files ──
*.tmp
*.temp
.cache/

# ── Local config overrides ──
docker-compose.override.yml
*.local.yml

# ── Secrets (safety) ──
*.pem
*.key
secrets/

# ── System files ──
*.pid
*.seed
*.pid.lock

# ── Python virtual environments ──
.venv*
packages/admin/.venv-admin/

# ── Salida de scaffolding del CLI (generada, nunca se commitea) ──
packages/cli/test-*-app*/

# ── Junk / diagnostic files ──
# `tmp/` no estaba ignorado y acumulaba 3 MB de builds sueltos que salían como
# ruido en cada `git status`.
tmp/
tmp_*.log
tmp_*.py
tserrors-*.txt
build-diag*.txt
kitsuden_progress.txt
progress.txt
tmp_labels.txt
tmp_dep_analysis.json
null
*.test-results.*

# ── Python (SDK) ──
__pycache__/
*.pyc
.pytest_cache/
dist-py/

# ── Local PGlite / Postgres data dir ──
.kitsuden/

# ── Salidas temporales de bun build (scratch, regenerables) ──
apps/api/tmp_build_*/

# ── Datos de juego de terceros (NO deben entrar en el repo) ──
# Volcados y catalogos extraidos de fuentes externas: la mayoria sin licencia
# permisiva. Son regenerables con gamedata/_scripts/*.mjs.
# Ver gamedata/docs/DATA-POLICY.md
#
# Los DATOS se quedan fuera; los SCRIPTS y la documentacion NO. Antes estaba
# todo ignorado con `gamedata/`, y eso contradecia la frase de arriba: los
# datos eran «regenerables con los scripts», pero los scripts no estaban en
# ningun sitio mas que en un disco. Se ignora el CONTENIDO (`gamedata/*`) y
# no la carpeta, porque git no puede volver a incluir nada dentro de una
# carpeta ignorada entera.
gamedata/*
!gamedata/_scripts/
!gamedata/docs/

# ── Volcados de cartas de TCG (143 MB) ──
# Misma clase que gamedata/ y por los mismos dos motivos, que ya estan escritos
# en gamedata/docs/DATA-POLICY.md: son datos de terceros con licencia por
# verificar, y son regenerables — aqui con scripts/scrape-tcg/*.mjs, uno por
# juego. Se versiona la receta, no el resultado.
#
# El tamano lo confirma: ficheros sueltos de hasta 20 MB que se descargarian en
# cada clon para siempre. kon-cardsim los lee de disco en tiempo de ejecucion,
# no los importa, asi que ignorarlos no rompe nada.
/data/

# Cache con rutas absolutas de la maquina que la genero (3,6 MB).
.cl.json

# Scripts y volcados sueltos de la raíz (2026-09-30): muchos llevan la cadena de
# conexión de la base de producción en claro y copias de contenido ajeno.
# Nunca deben subirse; lo que valga, que viva en apps/api/scripts o gamedata/_scripts.
/scratch-*
/scratch_*
/scrape_*
/scraped_aniimo_data/
/check-db*.mjs
/test-hono-route.mjs
/test-kon-mount.mjs
