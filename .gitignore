# =============================================================================
# Kitsuden — .gitignore
# =============================================================================
#
# This repository is the PUBLIC Kitsuden CMS. The same working folder also
# holds the owner's private sites, game data and scratch files; those are
# versioned (if at all) in a separate local repo — see `scripts/sitios-git.sh`.
#
# How this file works:
#   1. ROOT ALLOWLIST. Everything at the root is ignored unless it is listed
#      below, so loose scratch scripts, dumps and notes can never be added by
#      accident. To add a new top-level file or folder, add a `!/<name>` line.
#   2. PRIVATE CONTENT inside public folders is ignored by path.
#   3. Generic rules: build outputs, reports, logs, secrets and dumps.
#
# Database migrations (`**/migrations/*.sql`, `apps/api/drizzle/*.sql`) and
# seed files (`*.sql`) are source code and MUST stay tracked: no rule below
# ignores `*.sql`.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Root allowlist
# -----------------------------------------------------------------------------
/*

# Folders
!/.github/
!/.husky/
!/apps/
!/docker/
!/docs/
!/packages/
!/scripts/
!/skills/
!/tests/

# Tooling and config files
!/.dockerignore
!/.editorconfig
!/.gitattributes
!/.gitignore
!/.lintstagedrc.json
!/.nvmrc
!/.prettierignore
!/.prettierrc
!/bunfig.toml
!/eslint.config.js
!/package.json
!/playwright.config.ts
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.json
!/install.sh
!/install.ps1
!/vitest.config.ts
# Worktree setup for agent IDEs (docs/agents/orca.md)
!/orca.yaml
!/.worktreeinclude
# Agent instructions (AGENTS.md is read by Codex, Antigravity and others; CLAUDE.md imports it)
!/AGENTS.md
!/CLAUDE.md
# Only the shared Claude Code settings (worktrees and settings.local.json stay out, below)
!/.claude/

# Docker Compose (docker-compose.override.yml is a local override: not listed)
!/docker-compose.yml
!/docker-compose.automatic.yml
!/docker-compose.dev.yml
!/docker-compose.test.yml
!/docker-compose.tls.yml

# Environment templates (never the real files)
!/.env.example
!/.env.production.example
# Test-only credentials for the throwaway test database (docker-compose.test.yml).
# It contains no real secret; keep it that way.
!/.env.test

# Product documentation and launchers
!/ARCHITECTURE.md
!/BETA.md
!/CHANGELOG.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/CORE.md
!/LICENSE
!/QUICKSTART.md
!/README.md
!/SECURITY.md
!/START-GUIDE.md
!/start.bat


# -----------------------------------------------------------------------------
# 2. Private or local content inside public folders
# -----------------------------------------------------------------------------

# ── apps/: only the API, and only its source, config and docs ──
/apps/*
!/apps/api/
/apps/api/*
!/apps/api/.env.example
!/apps/api/bunfig.toml
!/apps/api/docs/
!/apps/api/drizzle/
# Historial que escribe el Vault al usarse (services/vault.ts): datos, no código
/apps/api/drizzle/vault/
!/apps/api/drizzle.config.ts
!/apps/api/evals/
!/apps/api/kitsuden.config.ts
!/apps/api/migrations/
!/apps/api/package.json
!/apps/api/scripts/
!/apps/api/src/
!/apps/api/tsconfig.json
# (left out: data/ with 2+ GB of third-party images, dist/, coverage and test
#  reports, tmp_build_*/, api.err/api.log, llms.txt — regenerated by Brain —
#  and the loose test-*.mjs / test-*.ts / update-theme.ts experiments)

# ── apps/api/scripts: allowlist of the GENERIC operations scripts ──
# The rest (per-game loaders `cargar-*.ts`, `podar-juego.ts`, tier-list and
# guide fixers, translation batches, one-off patchers, tmp/) operate the
# owner's sites and live in the private repo.
/apps/api/scripts/*
!/apps/api/scripts/apply-rls.ts
!/apps/api/scripts/backup.ts
!/apps/api/scripts/humo-blog-categorias.ts
!/apps/api/scripts/humo-rutas.ts
!/apps/api/scripts/humo-tierlist.ts
!/apps/api/scripts/matriz-de-autorizacion.ts
!/apps/api/scripts/migrate-api-keys-to-agents.ts
!/apps/api/scripts/migrate.ts
!/apps/api/scripts/normalizar-claves-de-kons.ts
!/apps/api/scripts/reparar-busqueda-de-datasets.ts
!/apps/api/scripts/reset.ts
!/apps/api/scripts/sdk-integracion-semilla.ts
!/apps/api/scripts/sdk-openapi.ts
!/apps/api/scripts/seed-mcp-test.ts
!/apps/api/scripts/sembrar-modulos.ts
!/apps/api/scripts/sonda-borradores.ts
!/apps/api/scripts/sonda-despliegue.ts
!/apps/api/scripts/sonda-superficie-admin.ts
!/apps/api/scripts/sonda-vistas.ts
!/apps/api/scripts/sync-kon-schema.ts
!/apps/api/scripts/test-aislado.mjs
!/apps/api/scripts/toon-benchmark.ts
!/apps/api/scripts/verificar-esquema.ts
!/apps/api/scripts/verify-public-config.ts
!/apps/api/scripts/verify-rls.ts
!/apps/api/scripts/lib/
/apps/api/scripts/lib/*
!/apps/api/scripts/lib/db-error.ts
!/apps/api/scripts/lib/esquemas-de-kons.ts
!/apps/api/scripts/lib/rls.ts
# (left out of lib/: the game modules — aniimo.ts, mhworld.ts, star-rail.ts,
#  tcg-juegos.ts… — and the loading pipeline built only for them: cargador.ts,
#  plan-de-carga.ts, espejo.mjs, imagenes-en-casa.ts, traducciones.ts…)

# ── docs/: product documentation only ──
# archive/, internal/, notes/, progress/ and the planning reports at the root
# of docs/ are internal working notes (some held real agent keys).
/docs/*
!/docs/ACTIONS_UNIFICATION.md
!/docs/CONTENT_PUBLISHING.md
!/docs/OPERACIONES.md
!/docs/QUICKSTART.md
!/docs/agents/
!/docs/ai/
!/docs/instalacion/
!/docs/install/
!/docs/kons/
!/docs/vibecoder/
/docs/vibecoder/ALINEACION_VIBECODER_AUDITORIA.md

# ── packages/ ──
# Kons (fase C): they live in the kitsuden-kons repository and are INSTALLED
# into packages/kons/<kon>/ by `kitsuden kon add` (copies, declared in the
# root kitsuden.kons.json, which the root allowlist already ignores). Only the
# folder's package.json (workspace root and marker) and README are tracked.
/packages/kons/*
!/packages/kons/package.json
!/packages/kons/README.md
# A local site of the maintainer, built from a copy of a starter, lives here;
# it is not part of the product (it has its own workspace and lockfile).
/packages/starters/kitsuden-blog-template/
# Diagnostic output
/packages/admin/check-output*.txt
/packages/grimoires/*/kitsuden-progress.txt
/packages/admin/svelte-check-warnings.txt
/packages/admin/svelte_migration.txt
/packages/admin/src/views/data-explorer-test.txt

# ── docker/: the owner's deployment of those sites ──
# (image of the four sites, their Caddyfile; overlay docker-compose.sitios.yml
#  at the root, already ignored by the root allowlist)
/docker/sitios/

# ── scripts/: launchers of the owner's sites ──
/scripts/start-cardback.mjs
/scripts/start-cozy.mjs
/scripts/start-todogachas.mjs
/scripts/start-valhalla.mjs
# Wrapper of the private repo (see PRIVADO.md, itself private)
/scripts/sitios-git.sh
/scripts/sitios-exclude.mjs

# ── tests/: tests of the owner's content ──
# They import the per-game loaders, the private starter or read gamedata/.
# The list is kept in sync by hand; `pnpm test:unit` on a clean public clone
# is the check.
/tests/unit/*-plan-de-carga.test.ts
/tests/unit/aniimo-guias-propias.test.ts
/tests/unit/arte-externo-del-juego.test.ts
