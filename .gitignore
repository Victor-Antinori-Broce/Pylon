# ── Dependencies ──
node_modules/
.pnpm-store/

# ── Build outputs ──
dist/
.astro/
.next/
build/

# ── Environment ──
.env
.env.local
.env.*.local

# ── Docker ──
docker/data/

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo

# ── OS ──
.DS_Store
Thumbs.db

# ── Payload CMS ──
apps/cms/media/

# ── Grimoires/Modules build artifacts ──
packages/grimoires/*/dist/
packages/grimoires/*/node_modules/
packages/realms/*/dist/
packages/realms/*/node_modules/

# ── Logs ──
*.log
npm-debug.log*
pnpm-debug.log*

# ── Coverage ──
coverage/

# ── Docker volumes ──
docker/data/
*.volume/

# ── Test results ──
test-results/
playwright-report/
*.test-results.*

# ── Build artifacts ──
*.tsbuildinfo
.eslintcache
.stylelintcache

# ── Compiled .ts artifacts in source directories ──
# These MUST NOT be tracked — they cause SvelteKit "Multiple layout module"
# crashes and pollute the source tree.

# Global: map files are always compiled
**/*.js.map
**/*.d.ts.map

# Apps
apps/admin/src/**/*.js
apps/admin/src/**/*.d.ts
apps/admin/.svelte-kit/
apps/api/src/**/*.js
apps/api/src/**/*.d.ts
apps/api/*.js
apps/api/*.d.ts
apps/api/scripts/*.js
apps/api/scripts/*.d.ts
apps/api/migrations/*.js
apps/api/migrations/*.d.ts
apps/api/drizzle/*.js
apps/api/drizzle/*.d.ts

# Packages
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/*.js
packages/*/*.d.ts
packages/admin/.svelte-kit/

# Tests & Scripts
tests/**/*.js
tests/**/*.d.ts
scripts/*.js
scripts/*.d.ts

# Root configs
playwright.config.js
playwright.config.d.ts

# Keep .svelte.ts files (they are source, not compiled)
!apps/admin/src/**/*.svelte.ts
!apps/admin/src/**/*.svelte.js
!packages/admin/src/**/*.svelte.ts
!packages/admin/src/**/*.svelte.js

# Keep legitimate config files
!**/postcss.config.js
!**/tailwind.config.js
!**/svelte.config.js
!**/vite.config.js
!**/vitest.config.js
!**/playwright.config.ts
!**/tsup.config.ts
!**/drizzle.config.ts
!**/svelte.config.ts

# CLI test app (generated, should not be tracked)
packages/cli/test-vibecoder-app/

# Keep CLI binaries and templates
!packages/cli/bin/*.js
!packages/cli/templates/**/*.js
!packages/cli/templates/**/*.d.ts

# Grimoires compiled artifacts (in grimoire root dirs)
packages/grimoires/*/*.js
packages/grimoires/*/*.d.ts
packages/grimoires/*/src/**/*.js
packages/grimoires/*/src/**/*.d.ts
packages/grimoires/*/tests/*.js
packages/grimoires/*/tests/*.d.ts
packages/grimoires/*/services/*.js
packages/grimoires/*/services/*.d.ts

# Starters compiled artifacts
packages/starters/*/*.js
packages/starters/*/*.d.ts
packages/starters/**/*.js
packages/starters/**/*.d.ts

# Tests compiled artifacts
tests/**/*.js
tests/**/*.d.ts

# Keep Django static files
!capacitaciones_app/static/**/*.js

# ── Temporary files ──
*.tmp
*.temp
.cache/

# ── Local config overrides ──
docker-compose.override.yml
*.local.yml

# ── Secrets (safety) ──
*.pem
*.key
secrets/

# ── System files ──
*.pid
*.seed
*.pid.lock
