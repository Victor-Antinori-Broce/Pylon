# -----------------------------------------------------------------------------
# 3. Generic rules (apply everywhere)
# -----------------------------------------------------------------------------

# ── Dependencies ──
node_modules/
.pnpm-store/
bun.lock
bun.lockb

# ── Build outputs ──
dist/
dist-*/
build/
.astro/
.next/
.svelte-kit/
.turbo/
.cache/
*.tsbuildinfo
.eslintcache
.stylelintcache
dist-py/
packages/cli/test-*-app*/
apps/api/tmp_build_*/

# Compiled .ts artifacts next to their sources. They break SvelteKit
# ("Multiple layout module") and pollute the tree.
**/*.js.map
**/*.d.ts.map
apps/api/src/**/*.js
apps/api/src/**/*.d.ts
apps/api/scripts/**/*.js
apps/api/scripts/**/*.d.ts
apps/api/migrations/*.js
apps/api/migrations/*.d.ts
apps/api/drizzle/*.js
apps/api/drizzle/*.d.ts
apps/api/*.js
apps/api/*.d.ts
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/*.js
packages/*/*.d.ts
packages/kons/*/*.js
packages/kons/*/*.d.ts
packages/kons/*/src/**/*.js
packages/kons/*/src/**/*.d.ts
packages/kons/*/tests/*.js
packages/kons/*/tests/*.d.ts
packages/kons/*/services/*.js
packages/kons/*/services/*.d.ts
packages/core/**/*.js
packages/core/**/*.d.ts
tests/**/*.js
tests/**/*.d.ts
scripts/*.js
scripts/*.d.ts
# …except real sources and configs
!tests/types/**/*.d.ts
!packages/admin/src/**/*.svelte.ts
!packages/admin/src/**/*.svelte.js
!packages/cli/bin/*.js
!packages/cli/templates/**/*.js
!packages/cli/templates/**/*.d.ts
!**/postcss.config.js
!**/tailwind.config.js
!**/svelte.config.js
!**/vite.config.js
!**/vitest.config.js
!**/eslint.config.js

# ── Generated files ──
.llms/
.cl.json

# ── Tests, coverage and reports ──
coverage/
coverage*.txt
cov*.txt
test-results/
test-results*.txt
*.test-results.*
playwright-report/
# Informes y OpenAPI generado de apps/api/scripts/schemathesis.ts (el baseline sí va al repo)
.schemathesis/
# SARIF de scripts/seguridad/aig.mjs (AI-Infra-Guard)
.aig/
tests.json
tsc-errors.txt
tserrors-*.txt
build-diag*.txt
check-output*.txt
progress.txt
*-progress.txt
kitsuden_progress.txt

# ── Logs ──
*.log
*.err
npm-debug.log*
pnpm-debug.log*

# ── Secrets ──
# `.env` in ANY folder; only the templates are tracked.
.env
.env.*
!.env.example
!.env.*.example
!/.env.test
.envrc
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets/

# ── Database dumps and backups (migrations and seeds stay tracked) ──
*.dump
*.sql.gz
*.sql.bz2
*.sql.zst
*.backup
*.bak
backups/

# ── Local data directories ──
.kitsuden/
docker/data/
*.volume/

# ── Native build outputs (.NET extractors, binaries) ──
**/obj/
**/bin/Debug/
**/bin/Release/
*.exe
*.dll
*.pdb

# ── Temporary files ──
tmp/
tmp-*
tmp_*
*.tmp
*.temp
scratch/
scratch-*
scratch_*

# ── Python ──
__pycache__/
*.pyc
.pytest_cache/
.venv*/

# ── Local overrides ──
docker-compose.override.yml
*.local.yml
*.pid
*.pid.lock

# ── Editors and OS ──
.vscode/
.idea/
.claude/*
!/.claude/settings.json
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Notas locales de planificación ──
/kitsuden2.md
