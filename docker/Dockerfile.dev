# ===================================================================
# Kitsuden - Development Image with Auto-Setup
#
# NOTE: For local development, prefer running apps locally with:
#   pnpm dev:infra   (starts DB, MinIO, Valkey in Docker)
#   pnpm dev         (starts API + Admin locally with hot reload)
#
# This image is for CI/testing or containerized dev environments only.
# ===================================================================

FROM oven/bun:1-alpine AS base

# Install Node.js and pnpm
RUN apk add --no-cache nodejs npm curl postgresql-client
RUN npm install -g pnpm@9.15.4

WORKDIR /app

# Copy workspace config
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY packages/admin/package.json ./packages/admin/
COPY packages/shared/package.json ./packages/shared/
COPY packages/engine/package.json ./packages/engine/
COPY packages/core/package.json ./packages/core/
COPY packages/kons/package.json ./packages/kons/
COPY packages/mcp-server/package.json ./packages/mcp-server/
COPY packages/sdk/package.json ./packages/sdk/
COPY packages/grimoires/package.json ./packages/grimoires/

# Install dependencies
RUN pnpm install --frozen-lockfile || pnpm install --no-frozen-lockfile

# Copy source
COPY . .

# Script de entrypoint para auto-setup
COPY docker/docker-entrypoint-dev.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint-dev.sh

EXPOSE 3000 3001 5173

ENTRYPOINT ["docker-entrypoint-dev.sh"]
CMD ["pnpm", "dev"]
