# ===================================================================
# DEPRECATED - Do not use this Dockerfile
#
# This standalone Admin Dockerfile has known issues:
#   1. Uses `bun install` but the project uses pnpm as package manager
#   2. Copies from `dist` but SvelteKit adapter-static outputs to `build/`
#   3. Missing VITE_API_URL env var (uses PUBLIC_API_URL which Vite ignores)
#
# Use instead:
#   docker build -f docker/Dockerfile.prod --target admin -t kitsuden-admin:latest .
#
# See docker-compose.yml for the correct production setup.
# ===================================================================

FROM oven/bun:1-alpine AS builder
WORKDIR /app

RUN apk add --no-cache nodejs npm && npm install -g pnpm@9.15.4

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/admin/package.json ./packages/admin/
COPY packages/shared/package.json ./packages/shared/

RUN pnpm install --frozen-lockfile || pnpm install --no-frozen-lockfile

COPY packages/admin ./packages/admin
COPY packages/shared ./packages/shared

RUN pnpm --filter @kitsuden/shared build

WORKDIR /app/packages/admin
ENV NODE_ENV=production
ARG PUBLIC_API_URL=http://localhost:3000
ENV PUBLIC_API_URL=${PUBLIC_API_URL}
ENV VITE_API_URL=${PUBLIC_API_URL}
RUN pnpm run build

# Production stage with nginx
FROM nginx:alpine AS production

# SvelteKit adapter-static outputs to build/, not dist/
COPY --from=builder /app/packages/admin/build /usr/share/nginx/html
COPY docker/nginx-admin.conf /etc/nginx/conf.d/default.conf

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:80/ || exit 1

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
