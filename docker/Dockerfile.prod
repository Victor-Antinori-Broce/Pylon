# syntax=docker/dockerfile:1.7-labs
# ^ necesaria para `COPY --parents`, que preserva la ruta de origen.
# ===================================================================
# Kitsuden - Production Dockerfile (Multi-Stage + BuildKit Cache)
#
# Builds:
#   - API (Bun runtime)
#   - Admin (SvelteKit static + nginx)
#
# USAGE:
#   docker build -f docker/Dockerfile.prod --target api -t kitsuden/api:latest .
#   docker build -f docker/Dockerfile.prod --target admin -t kitsuden/admin:latest .
#
# DUAL MODE SUPPORT:
#   Option A (Vibecoder):  docker compose up -d          (pulls pre-built images)
#   Option B (Developer):  docker compose up -d --build  (builds from source)
#
# BUILDKIT REQUIRED for cache mounts:
#   export DOCKER_BUILDKIT=1
#   docker build ...
#
# OPTIMIZATIONS:
#   - BuildKit cache mounts for pnpm store (fast rebuilds)
#   - Sharp compiled in builder, not in final image
#   - No build dependencies in final image (python3, make, g++)
# ===================================================================

# syntax=docker/dockerfile:1

# ===================================================================
# STAGE 1: Base with pnpm
# ===================================================================
FROM oven/bun:1-alpine AS base
RUN apk add --no-cache nodejs npm curl
WORKDIR /app
RUN npm install -g pnpm@9.15.4

# ===================================================================
# Kons: contexto por defecto VACÍO. `--build-context kons=<ruta>` (o
# `additional_contexts` en compose) lo sustituye por un checkout de
# kitsuden-kons; ver la etapa `dependencies`.
# ===================================================================
FROM scratch AS kons

# ===================================================================
# STAGE 2: Dependencies - Install all dependencies with cache
# ===================================================================
FROM base AS dependencies

# Copy workspace configuration
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Manifiestos de TODOS los proyectos del workspace, para cachear la instalacion.
#
# Esto era una lista escrita a mano de 14 rutas, y el workspace tiene 53
# proyectos. Lo que faltaba no fallaba de forma visible: simplemente sus
# dependencias no se instalaban, y el build moria mucho despues con un
# `Could not resolve` que parecia otra cosa. Asi se perdio `openai`, que declara
# `packages/core/vector-search` — un paquete propio cuyo manifiesto nadie copiaba.
#
# `--parents` preserva la ruta de origen. Sin el, `COPY packages/kons/*/package.json
# ./packages/kons/` APLASTA los 30 ficheros sobre el mismo destino y solo
# sobrevive el ultimo; era el caso hasta ahora.
#
# Los globs siguen a `pnpm-workspace.yaml`: `apps/*`, `packages/*` y los de dos
# niveles (`packages/core/*`, `packages/kons/*`, `packages/starters/*`).
COPY --parents apps/*/package.json packages/*/package.json packages/*/*/package.json ./

# ── Kons instalados (fase C) ───────────────────────────────────────────────
#
# Los kons ya no viven en este repositorio (repo kitsuden-kons). La imagen
# instala los que diga KITSUDEN_KONS ("blog,wiki,…"), copiándolos del contexto
# de build ADICIONAL `kons`:
#
#   docker build --build-context kons=../kitsuden-kons #     --build-arg KITSUDEN_KONS="blog,wiki" -f docker/Dockerfile.prod --target api .
#
# (con compose: `additional_contexts: { kons: … }` y `args: { KITSUDEN_KONS: … }`).
# Por defecto el contexto es la etapa vacía `kons` (arriba) y la lista está
# vacía: la imagen pública lleva solo el núcleo. Las copias de packages/kons/kon-* del
# árbol de trabajo NO entran (.dockerignore): lo que hay en la imagen es lo
# declarado, no lo que haya en la carpeta de quien construye.
#
# Va ANTES de `pnpm install` porque cada kon es un paquete del workspace con sus
# propias dependencias. También escribe /app/kitsuden.kons.json, que es lo que
# la API lee para saber qué está instalado.
ARG KITSUDEN_KONS=""
COPY docker/instalar-kons.mjs ./docker/instalar-kons.mjs
RUN --mount=type=bind,from=kons,target=/kons-src     KITSUDEN_KONS="${KITSUDEN_KONS}" node docker/instalar-kons.mjs /kons-src

# Install dependencies with BuildKit cache mount for pnpm store
# This makes reinstalls almost instant on rebuilds
#
# --ignore-scripts NO es opcional aqui, y conviene saber por que:
#
# En esta capa solo se han copiado los `package.json` — a proposito, para que
# cambiar codigo no invalide la instalacion. Pero `@kitsuden/shared` declara
# `prepare: bun run scripts/build.ts`, y pnpm ejecuta el `prepare` de los
# paquetes del workspace al instalar. Ese fichero todavia no existe en la
# imagen: bun aborta con `Module not found "scripts/build.ts"` y se lleva por
# delante el `pnpm install` entero. El `|| pnpm install` de respaldo fallaba
# por lo mismo, claro.
#
# Los scripts de las dependencias (sharp, esbuild, msgpackr...) no se pierden:
# `builder` hace `pnpm rebuild` cuando ya tiene el codigo completo, y es de
# `builder` —no de esta etapa— de donde el runtime copia `node_modules`.
#
# --frozen-lockfile y SIN respaldo (auditoría 2026-10-25): el `|| pnpm install`
# de antes volvía a resolver versiones si el lockfile no casaba, y la imagen de
# producción podía llevar dependencias que nadie había revisado. Ahora un
# lockfile desfasado para el build con ERR_PNPM_OUTDATED_LOCKFILE. Ojo con los
# kons de KITSUDEN_KONS: sus package.json vienen de kitsuden-kons y tienen que
# estar en pnpm-lock.yaml TAL CUAL (instalarlos en el árbol con `kitsuden kon
# add`, `pnpm install` y subir el lockfile antes de construir).
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    --mount=type=cache,target=/root/.cache \
    pnpm install --frozen-lockfile --prefer-offline --ignore-scripts

# ===================================================================
# STAGE 3: Builder - Compile everything
# ===================================================================
FROM dependencies AS builder

# Build tools for native modules (sharp, etc.)
RUN apk add --no-cache python3 make g++

# API URL for admin build (empty = relative /api/* calls via nginx proxy)
ARG PUBLIC_API_URL=""
ENV PUBLIC_API_URL=${PUBLIC_API_URL}
ENV VITE_API_URL=${PUBLIC_API_URL}

# Copy source code
COPY . .

# Ahora SI se ejecutan los scripts de instalacion de las dependencias, que la
# etapa anterior salto con --ignore-scripts. Aqui ya esta todo el codigo: sharp
# compila contra musl y esbuild coloca su binario de plataforma. No cuesta
# cache — el `COPY . .` de arriba ya invalida con cualquier cambio de codigo.
RUN pnpm rebuild

# Build workspace packages in dependency order
# Only packages that actually produce dist/ artifacts need explicit builds here.
# Packages like engine, core, grimoires, kons(root) have no-op build scripts
# and are consumed as TS source by Bun.

RUN --mount=type=cache,target=/app/packages/shared/.tsbuildinfo \
    pnpm --filter @kitsuden/shared build

RUN --mount=type=cache,target=/app/packages/sdk/.tsbuildinfo \
    pnpm --filter @kitsuden/sdk build

RUN --mount=type=cache,target=/app/packages/mcp-server/.tsbuildinfo \
    pnpm --filter @kitsuden/mcp-server build

# Compilar (tsc) los kons que tienen script de build.
#
# Bun los ejecuta como fuente TS, asi que su dist/ no se usa en ejecucion: este
# paso es la COMPROBACION DE TIPOS de los kons. Antes terminaba en
# `|| echo "Warning: Some kons failed to build, continuing..."`, que convertia
# cualquier kon roto en un aviso perdido en el log del build (asi paso con
# kon-broadcast, auditoria 2026-10-18). Sin el `||`, un kon que no compila
# para el build: es lo que queremos.
#
# Sin kons instalados no hay nada que filtrar: pnpm avisa y sale con 0.
RUN pnpm --filter "@kitsuden/kon-*" build

# Build API
#
# NODE_ENV=production AL COMPILAR, no solo al ejecutar: `bun build` sustituye
# la expresión literal `process.env.NODE_ENV` por el valor que tiene en este
# momento, y sin esto se congelaba como "development" (2026-10-12: guardas de
# producción compiladas como `if (false)` en un contenedor con
# NODE_ENV=production). El código ya lo lee en ejecución
# (apps/api/src/lib/entorno.ts); esto cierra lo que quede o se escriba nuevo.
RUN --mount=type=cache,target=/app/apps/api/.tsbuildinfo \
    NODE_ENV=production pnpm --filter @kitsuden/api build

# Remove conflicting generated JS files before admin build
RUN find packages/admin/src -name "+layout.js" -type f -delete 2>/dev/null || true

# Build Admin (SvelteKit)
RUN --mount=type=cache,target=/app/packages/admin/.vite \
    pnpm --filter @kitsuden/admin build

# Rebuild sharp for Alpine/musl
RUN SHARP_IGNORE_GLOBAL_LIBVIPS=1 pnpm rebuild sharp

# ===================================================================
# STAGE 4: API Runtime - Minimal image for backend
# ===================================================================
FROM oven/bun:1-alpine AS api
WORKDIR /app

# nodejs: el sandbox del codigo de usuario corre su interprete (QuickJS) en un
# proceso hijo con `node --permission` (sin escritura, sin procesos, sin hilos;
# solo lee los paquetes de QuickJS). Sin Node caeria a Bun, que no tiene modelo
# de permisos. Ver apps/api/src/lib/worker-sandbox.ts y docs/agents/sandbox.md.
RUN apk add --no-cache postgresql-client curl nodejs

# Copy built API artifact
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Copy API source for dynamic imports used by startup scripts & module-loader
COPY --from=builder /app/apps/api/src ./apps/api/src
COPY --from=builder /app/apps/api/drizzle ./apps/api/drizzle
# El runner de migraciones vive aqui y se ejecuta en el arranque del contenedor
# (start-with-check.sh paso 4). Sin esta copia, el contenedor arranca sin poder
# migrar y la API levanta contra un esquema desactualizado.
COPY --from=builder /app/apps/api/scripts ./apps/api/scripts
COPY --from=builder /app/apps/api/migrations ./apps/api/migrations
COPY --from=builder /app/apps/api/kitsuden.config.ts ./apps/api/kitsuden.config.ts
COPY --from=builder /app/apps/api/drizzle.config.ts ./apps/api/drizzle.config.ts
COPY --from=builder /app/apps/api/package.json ./apps/api/

# Los enlaces de dependencias de apps/api.
#
# Hacen falta porque el bundle NO lleva dentro los modulos nativos (`sharp`,
# `@node-rs/argon2`): esos van `--external`, y por tanto se resuelven en
# ejecucion desde la carpeta del bundle, `/app/apps/api/dist/`. Sin este COPY,
# la busqueda sube por `apps/api/node_modules` —que no existia—, `apps/` y
# `/app/node_modules`, y no encuentra nada: el contenedor moria con
# `Failed to load native binding`, teniendo el binario dentro de la imagen.
#
# Son enlaces simbolicos que apuntan a `/app/node_modules/.pnpm/...`, que ya se
# copia justo debajo, asi que esto casi no ocupa: es el mapa, no el territorio.
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /app/docker ./docker

# Copy workspace packages that API imports dynamically
# engine, core, grimoires are consumed as TS source (Bun runs TS natively)
COPY --from=builder /app/packages/shared ./packages/shared
COPY --from=builder /app/packages/engine ./packages/engine
COPY --from=builder /app/packages/core ./packages/core
COPY --from=builder /app/packages/codegen ./packages/codegen
COPY --from=builder /app/packages/sdk ./packages/sdk
COPY --from=builder /app/packages/mcp-server ./packages/mcp-server
# Las COPIAS de los kons instalados (ver la etapa `dependencies`) y la lista
# que la API lee para saber qué hay instalado.
COPY --from=builder /app/packages/kons ./packages/kons
COPY --from=builder /app/kitsuden.kons.json ./kitsuden.kons.json
COPY --from=builder /app/packages/grimoires ./packages/grimoires

# Copy node_modules with pnpm symlinks intact
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-workspace.yaml ./

# Carpetas en las que la API ESCRIBE en ejecucion, a nombre del usuario `bun`
# (uid/gid 1000, lo trae la imagen base; el mismo que `user: "1000:1000"` de
# docker-compose.tls.yml):
#
#   /app/data                    STORAGE_LOCAL_PATH: el volumen de medios
#   /app/uploads, /app/logs      subidas y logs locales
#   /app/apps/api/.kitsuden      datos locales de la API (el sandbox ya no escribe aqui)
#   /app/apps/api/drizzle/vault  instantaneas DDL del vault (si se activa)
#   /tmp                         ya es de todos (1777) en la imagen base
#
# Un volumen con nombre VACIO copia el dueno de su carpeta al montarse por
# primera vez, asi que en una maquina nueva todo funciona sin hacer nada. Un
# volumen YA EXISTENTE conserva su dueno: si lo lleno root (`docker cp`, una
# restauracion, una imagen anterior que corria como root), las subidas fallan
# con EACCES hasta hacer `chown -R 1000:1000` sobre el volumen — ver
# docs/instalacion/servidor.md.
#
# El resto de /app (codigo, node_modules) sigue siendo de root y de solo
# lectura para la API: un fallo en la API no puede reescribir su propio codigo.
RUN mkdir -p uploads logs data apps/api/.kitsuden apps/api/drizzle/vault \
 && chown -R bun:bun uploads logs data apps/api/.kitsuden apps/api/drizzle/vault

# Sin root. start-with-check.sh no necesita privilegios: migrar, crear el rol
# de aplicacion y verificar RLS son conexiones a Postgres (con la URL de
# admin), no operaciones del sistema; y en disco solo escribe lo de arriba.
USER bun

ENV NODE_ENV=production
ENV PORT=3000
# Todas las interfaces DENTRO del contenedor (Docker reenvia a su IP, no a su
# loopback). Lo que se publica en el host lo decide `ports:` del compose.
ENV HOST=0.0.0.0
ENV KITSUDEN_AUTO_SETUP=true

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
# 127.0.0.1 y /live, por el mismo motivo que en la imagen del admin y en
# docker-compose.yml:
#
#   · 127.0.0.1, no `localhost`: hoy bun escucha en doble pila (`:::3000`) y
#     ambas funcionan, pero nginx —con `listen 80;`— solo escuchaba en IPv4 y
#     `localhost` resolvia a ::1: el contenedor servia el sitio y figuraba
#     `unhealthy` para siempre. La regla se aplica igual aqui para que no
#     dependa de que el runtime siga siendo de doble pila.
#
#   · /live, no /api/health: liveness puro. /api/health comprueba base, cola y
#     cache, asi que un fallo temporal de Valkey marcaria la API como muerta y
#     Docker la reiniciaria en bucle. Y NO lleva prefijo /api: las rutas de
#     observabilidad se montan en la raiz (src/lib/critical-features.ts).
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/live || exit 1

CMD ["sh", "/app/docker/start-with-check.sh"]

# ===================================================================
# STAGE 5: Admin Runtime - Static files served by nginx
# ===================================================================
FROM nginx:alpine AS admin

COPY --from=builder /app/packages/admin/build /usr/share/nginx/html
COPY docker/nginx-admin.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
# 127.0.0.1, NO localhost: en esta imagen `localhost` resuelve primero a `::1`
# y nginx escucha solo en IPv4 (`listen 80;` en nginx-admin.conf). El resultado
# era un contenedor que servia el admin perfectamente —200 en el puerto 3001—
# y que Docker marcaba `unhealthy` para siempre, con
# `wget: can't connect to remote host: Connection refused` como unica pista.
#
# Si algun dia nginx escucha tambien en IPv6 (`listen [::]:80;`), esto seguira
# siendo correcto: se comprueba la pila que de verdad sirve el trafico.
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
