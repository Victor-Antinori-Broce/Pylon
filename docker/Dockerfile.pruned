# ===================================================================
# DEPRECATED - Use docker/Dockerfile.prod instead
#
# Same issue as Dockerfile.optimized: the API CMD `bun run dist/index.js`
# will fail because Bun needs .ts sources for grimoire dynamic imports.
# The pnpm --prod install also strips drizzle-kit needed for migrations.
#
# Use: docker build -f docker/Dockerfile.prod --target api .
# ===================================================================
# GremiusCMS - Dockerfile with Dependency Pruning [DEPRECATED]

FROM oven/bun:1-alpine AS base
RUN apk add --no-cache nodejs npm
WORKDIR /app
RUN npm install -g pnpm@9.15.4

# ═══════════════════════════════════════════════════════════════════════════
# STAGE 1: Dependencies
# ═══════════════════════════════════════════════════════════════════════════
FROM base AS dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY packages/admin/package.json ./packages/admin/
COPY packages/shared/package.json ./packages/shared/
COPY packages/mcp-server/package.json ./packages/mcp-server/
COPY packages/sdk/package.json ./packages/sdk/
COPY packages/engine/package.json ./packages/engine/
COPY packages/core/package.json ./packages/core/
COPY packages/grimoires/package.json ./packages/grimoires/
COPY packages/realms/package.json ./packages/realms/
RUN pnpm install --no-frozen-lockfile

# ═══════════════════════════════════════════════════════════════════════════
# STAGE 2: Builder
# ═══════════════════════════════════════════════════════════════════════════
FROM dependencies AS builder
RUN apk add --no-cache python3 make g++
ARG PUBLIC_API_URL=http://localhost:3000
ENV PUBLIC_API_URL=${PUBLIC_API_URL}
ENV VITE_API_URL=${PUBLIC_API_URL}
COPY . .
RUN pnpm --filter @gremius/shared build
RUN pnpm --filter @gremius/api build
RUN pnpm --filter @gremius/admin build
RUN SHARP_IGNORE_GLOBAL_LIBVIPS=1 pnpm rebuild sharp

# ═══════════════════════════════════════════════════════════════════════════
# STAGE 3: API - PRUNED RUNTIME
# ═══════════════════════════════════════════════════════════════════════════
FROM oven/bun:1-alpine AS api
RUN apk add --no-cache nodejs npm postgresql-client
WORKDIR /app
RUN npm install -g pnpm@9.15.4

# Copy compiled bundles
COPY --from=builder /app/apps/api/dist ./dist
COPY --from=builder /app/apps/api/package.json ./package.json
COPY --from=builder /app/docker/start-with-check.sh ./docker/start-with-check.sh

# Copy workspace packages (built)
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/package.json

# Copy source packages for dynamic imports
COPY --from=builder /app/packages/grimoires ./packages/grimoires
COPY --from=builder /app/packages/realms ./packages/realms
COPY --from=builder /app/packages/core ./packages/core
COPY --from=builder /app/packages/engine ./packages/engine

# Copy root config files for pnpm
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=builder /app/pnpm-lock.yaml ./pnpm-lock.yaml

# Re-install only production dependencies
RUN pnpm install --prod --no-frozen-lockfile

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1

CMD ["bun", "run", "dist/index.js"]

# ═══════════════════════════════════════════════════════════════════════════
# STAGE 4: Admin
# ═══════════════════════════════════════════════════════════════════════════
FROM nginx:alpine AS admin
COPY --from=builder /app/packages/admin/build /usr/share/nginx/html
COPY docker/nginx-admin.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:80/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
