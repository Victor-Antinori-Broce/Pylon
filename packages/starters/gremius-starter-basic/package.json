{
  "name": "@gremius/starter-basic",
  "version": "1.0.0",
  "description": "Official Gremius Basic Starter - Zero to production in 5 minutes",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "pnpm -r start",
    "db:push": "cd apps/api && pnpm db:push",
    "db:migrate": "cd apps/api && pnpm db:migrate",
    "db:studio": "cd apps/api && pnpm db:studio",
    "db:seed": "cd apps/api && pnpm db:seed",
    "setup": "pnpm install && docker compose up -d && sleep 5 && pnpm db:push && pnpm db:seed"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
