{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kitsuden.dev/schemas/kon-schema.json",
  "title": "Manifiesto de un kon (kon.json)",
  "description": "Cuatro manifiestos apuntaban a este fichero con `$schema` y el fichero no existía, así que NADA validaba los kon.json. El resultado fue deriva de forma con consecuencias reales: kon-academy-lms y kon-crm declaraban sus tablas en `database.tables`, un campo que ningún lector consulta, y el panel de módulos las contaba como cero. Este esquema fija la forma; tests/unit/kon-manifest.test.ts la exige.",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "version",
    "type",
    "tier",
    "icon",
    "schema",
    "madurez"
  ],
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^kon-[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Debe coincidir con el nombre de la carpeta: la resolución va por este id, no por el directorio."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+"
    },
    "sdk": {
      "type": "integer",
      "minimum": 1,
      "description": "Kon SDK contract version this kon is written for (GET /api/version → sdk.kons). The loader refuses to mount a kon whose sdk is greater than the core's."
    },
    "type": {
      "const": "kon"
    },
    "tier": {
      "enum": [
        "essential",
        "common",
        "specialized"
      ],
      "description": "Nivel de activación del kon."
    },
    "madurez": {
      "type": "string",
      "enum": [
        "estable",
        "beta",
        "experimental"
      ],
      "description": "Maturity. estable = used end to end in real production; beta = works and is tested, with gaps or little real use; experimental = nobody has used it end to end."
    },
    "icon": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string"
    },
    "layer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "order": {
      "type": "integer"
    },
    "core": {
      "type": "boolean"
    },
    "defaultEnabled": {
      "type": "boolean"
    },
    "schema": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "strategy"
      ],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "enum": [
            "drizzle",
            "sql"
          ],
          "description": "\"drizzle\": las tablas las gestiona drizzle-kit y el kon entra en schema-kons.generated.ts. \"sql\": el kon automigra con su propio SQL y se EXCLUYE del agregado para no chocar con los enums globales de Postgres."
        },
        "entry": {
          "type": [
            "string",
            "null"
          ],
          "description": "Ruta al módulo de esquema, relativa a la raíz del kon. Obligatoria si strategy es \"drizzle\"."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "drizzle"
              }
            }
          },
          "then": {
            "required": [
              "entry"
            ]
          }
        }
      ],
      "description": "null en los kons que no crean tablas (p.ej. los overlays broadcast-*)."
    },
    "tables": {
      "type": "array",
      "description": "ÚNICO sitio donde declarar tablas. Se lee en routes/modules.ts y routes/data-explorer.ts. Un `database.tables` paralelo no lo lee nadie.",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "primaryKey": {
                "type": "string"
              },
              "searchableFields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "filterableFields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "readonly": {
                "type": "boolean"
              }
            }
          }
        ]
      }
    },
    "database": {
      "type": "object",
      "description": "Metadatos sueltos. NO admite `tables`: ese campo aquí es invisible para el runtime.",
      "not": {
        "required": [
          "tables"
        ]
      }
    },
    "mount": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/api/[a-z0-9-]+(/[a-z0-9-]+)*$"
        },
        "router": {
          "type": "string"
        }
      }
    },
    "entryPoint": {
      "type": "string"
    },
    "exports": {
      "type": "object"
    },
    "features": {
      "type": [
        "array",
        "object"
      ],
      "description": "Documentación, no la lee el runtime. Lista de etiquetas u objeto estructurado."
    },
    "dependencies": {
      "type": "object"
    },
    "optionalDependencies": {
      "type": "object"
    },
    "compatibility": {
      "type": "object"
    },
    "documentation": {
      "type": [
        "string",
        "object"
      ]
    },
    "toggle": {
      "type": "object"
    },
    "kitsuden": {
      "type": [
        "string",
        "object"
      ]
    },
    "manifest": {
      "const": 1,
      "description": "Kon manifest spec version (docs/kons/registry.md). Optional for source installs; publishing to a registry validates the kon against spec 1."
    },
    "repository": {
      "type": [
        "string",
        "object"
      ],
      "description": "Source repository: a URL, or {type, url, directory} like package.json."
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "description": "What the kon asks for, shown to the user on install and diffed on update (docs/kons/registry.md). Required to publish; empty lists are an explicit 'none'.",
      "properties": {
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Scopes the kon's code uses or grants (kon:<short>:<op>, datasets:*:read…); a leading ! is a denial."
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Outbound hosts the kon calls (api.example.com, *.example.com). Empty = no outbound network."
        },
        "sensitive": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ids of the kon's sensitive operations (the ones with sensible: true)."
        }
      }
    },
    "admin": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "category": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        },
        "apiBase": {
          "type": "string"
        },
        "hasCustomView": {
          "type": "boolean"
        },
        "defaultView": {
          "type": "string"
        },
        "quickActions": {
          "type": "array"
        },
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "grid",
                  "kanban",
                  "calendar",
                  "dashboard",
                  "custom",
                  "element"
                ],
                "description": "\"custom\" exige un componente registrado en el admin; \"element\" es un Web Component cargado en tiempo de ejecución."
              },
              "title": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "table": {
                "type": "string"
              },
              "component": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
