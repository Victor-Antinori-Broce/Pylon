{
  "$schema": "../../schemas/grimoire-schema.json",
  "id": "grimoire-blog",
  "name": "Blog & Content Publishing",
  "description": "Complete CMS publishing platform. Includes all content management features: rich text editing, SEO metadata, slugs, editorial workflow, scheduling, and public content API.",
  "version": "2.0.0",
  "type": "grimoire-core",
  "category": "core",
  "order": 3,
  "core": true,
  "defaultEnabled": true,
  "layer": 3,
  "author": "Gremius Team",
  "license": "MIT",
  "icon": "FileText",
  "mount": {
    "path": "/api/blog",
    "router": "blogRoutes"
  },
  "entryPoint": "./src/index.ts",
  "exports": {
    "routes": "./src/index.ts",
    "schema": "./src/schema.ts"
  },
  "tables": ["blog_posts", "blog_posts_to_tags", "blog_posts_to_games"],
  "database": {
    "tables": ["blog_posts", "blog_posts_to_tags", "blog_posts_to_games"],
    "enums": ["blog_status"]
  },
  "admin": {
    "category": "core",
    "order": 3,
    "icon": "FileText",
    "defaultView": "posts",
    "views": [
      {
        "id": "posts",
        "type": "custom",
        "title": "All Posts",
        "icon": "FileText"
      },
      {
        "id": "drafts",
        "type": "grid",
        "title": "Drafts",
        "table": "blog_posts",
        "icon": "Pencil",
        "defaultFilter": { "status": "draft" }
      },
      {
        "id": "scheduled",
        "type": "grid",
        "title": "Scheduled",
        "table": "blog_posts",
        "icon": "Calendar",
        "defaultFilter": { "status": "scheduled" }
      }
    ]
  },
  "features": [
    "posts-crud",
    "rich-text-editor",
    "scheduling",
    "tags",
    "seo-overrides",
    "slug-management",
    "featured-images",
    "authorship",
    "reading-time",
    "content-blocks",
    "realtime-updates",
    "public-content-api",
    "editorial-workflow"
  ],
  "postStatuses": ["draft", "scheduled", "published", "archived"],
  "dependencies": {
    "grimoires": ["grimoire-media"],
    "core": ["auth"]
  },
  "compatibility": {
    "gremius": ">=0.8.0"
  },
  "documentation": {
    "readme": "./README.md"
  }
}
