{
  "name": "@gremius/grimoire-games",
  "version": "2.1.0",
  "description": "Game library with IGDB integration, collections, platforms, tags, screenshots, and trailers",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "build": "pnpm exec tsc",
    "dev": "pnpm exec tsc --watch"
  },
  "keywords": [
    "gremius",
    "grimoire",
    "games",
    "igdb",
    "catalog",
    "gaming"
  ],
  "author": "Gremius Team",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@gremius/shared": "workspace:*",
    "hono": "^4.7.0",
    "drizzle-orm": "^0.45.0"
  },
  "gremius": {
    "type": "grimoire",
    "id": "grimoire-games",
    "category": "gaming",
    "order": 12,
    "core": false,
    "defaultEnabled": false,
    "minVersion": "0.8.0"
  }
}
