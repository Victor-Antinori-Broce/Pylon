{
  "name": "@gremius/grimoire-media",
  "version": "1.0.0",
  "description": "Gremius Core Grimoire - Media Library (File uploads, S3/MinIO storage, image optimization)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm exec tsc",
    "dev": "pnpm exec tsc --watch"
  },
  "keywords": [
    "gremius",
    "grimoire",
    "core",
    "media",
    "uploads",
    "s3"
  ],
  "author": "Gremius Team",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@gremius/shared": "workspace:*",
    "hono": "^4.7.0",
    "drizzle-orm": "^0.45.0",
    "zod": "^3.23.0"
  },
  "gremius": {
    "type": "grimoire",
    "id": "grimoire-media",
    "category": "core",
    "order": 1,
    "core": true,
    "defaultEnabled": true,
    "minVersion": "0.8.0"
  }
