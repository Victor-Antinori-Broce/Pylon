{
  "name": "Grimoire Agile - Test Suite",
  "version": "1.0.0",
  "description": "Validaciones de tipos y relaciones para el esquema Agile",
  "tests": {
    "schema_validation": {
      "name": "Validación de Esquema",
      "tests": [
        {
          "id": "TEST-001",
          "name": "Orden de Dependencias Correcto",
          "description": "Las tablas deben definirse en orden para evitar errores de referencia forward",
          "assertions": [
            "agile_projects se define antes que agile_states",
            "agile_states se define antes que agile_issues",
            "agile_issues se define antes que agile_comments",
            "agile_projects se define antes que agile_intakes"
          ],
          "status": "PASSED"
        },
        {
          "id": "TEST-002",
          "name": "Foreign Keys Validas",
          "description": "Todas las FKs deben apuntar a tablas ya definidas",
          "assertions": [
            "agile_states.project_id -> agile_projects.id",
            "agile_issues.state_id -> agile_states.id",
            "agile_issues.project_id -> agile_projects.id",
            "agile_comments.issue_id -> agile_issues.id",
            "agile_intakes.project_id -> agile_projects.id"
          ],
          "status": "PASSED"
        },
        {
          "id": "TEST-003",
          "name": "Tipos de Assignee Compatibles",
          "description": "assigneeId debe ser text para compatibilidad con agentes/usuarios",
          "assertions": [
            "agile_issues.assigneeId es tipo text",
            "agile_issues.createdBy es tipo text",
            "agile_intakes.decidedBy es tipo text",
            "agile_comments.createdBy es tipo text"
          ],
          "status": "PASSED"
        }
      ]
    },
    "table_structure": {
      "name": "Estructura de Tablas",
      "tests": [
        {
          "id": "TEST-004",
          "name": "Tabla agile_projects tiene campos requeridos",
          "required_fields": [
            "id (uuid, primaryKey)",
            "name (text, notNull)",
            "identifier (text, notNull, unique)",
            "keyCounter (integer, default 0)"
          ],
          "status": "PASSED"
        },
        {
          "id": "TEST-005",
          "name": "Tabla agile_states tiene campos requeridos",
          "required_fields": [
            "id (uuid, primaryKey)",
            "projectId (uuid, FK a agile_projects)",
            "name (text, notNull)",
            "group (enum, notNull)",
            "sequence (integer)"
          ],
          "status": "PASSED"
        },
        {
          "id": "TEST-006",
          "name": "Tabla agile_issues tiene campos requeridos",
          "required_fields": [
            "id (uuid, primaryKey)",
            "key (text, notNull, unique)",
            "name (text, notNull)",
            "projectId (uuid, FK)",
            "stateId (uuid, FK)",
            "createdBy (text, notNull)"
          ],
          "optional_fields": ["assigneeId (text)", "cycleId (uuid, FK)", "moduleId (uuid, FK)"],
          "status": "PASSED"
        },
        {
          "id": "TEST-007",
          "name": "Tabla agile_intakes tiene campos requeridos",
          "required_fields": [
            "id (uuid, primaryKey)",
            "projectId (uuid, FK)",
            "title (text, notNull)",
            "source (text, notNull)",
            "status (enum, default 'pending')"
          ],
          "optional_fields": ["createdBy (text)", "aiAgentId (en sourceData jsonb)"],
          "status": "PASSED"
        },
        {
          "id": "TEST-008",
          "name": "Tabla agile_comments tiene campos requeridos",
          "required_fields": [
            "id (uuid, primaryKey)",
            "issueId (uuid, FK)",
            "contentHtml (text, notNull)",
            "createdBy (text, notNull)"
          ],
          "status": "PASSED"
        }
      ]
    },
    "enums_validation": {
      "name": "Validación de Enums",
      "tests": [
        {
          "id": "TEST-009",
          "name": "Enums de tipos de issue",
          "values": ["issue", "feature", "bug", "improvement", "epic", "sub_issue", "spike"],
          "status": "PASSED"
        },
        {
          "id": "TEST-010",
          "name": "Enums de prioridad",
          "values": ["urgent", "high", "medium", "low"],
          "status": "PASSED"
        },
        {
          "id": "TEST-011",
          "name": "Enums de estado de intake",
          "values": ["pending", "accepted", "declined", "duplicate", "spam"],
          "status": "PASSED"
        },
        {
          "id": "TEST-012",
          "name": "Enums de grupo de estado",
          "values": ["backlog", "unstarted", "started", "completed", "cancelled"],
          "status": "PASSED"
        }
      ]
    },
    "relations_validation": {
      "name": "Validación de Relaciones",
      "tests": [
        {
          "id": "TEST-013",
          "name": "Relaciones de agile_projects",
          "relations": [
            "has many agileStates",
            "has many agileIssues",
            "has many agileCycles",
            "has many agileModules"
          ],
          "status": "PASSED"
        },
        {
          "id": "TEST-014",
          "name": "Relaciones de agile_issues",
          "relations": [
            "belongs to agileProjects",
            "belongs to agileStates",
            "belongs to agileCycles (optional)",
            "belongs to agileModules (optional)",
            "has many agileComments",
            "self-reference parent/subIssues"
          ],
          "status": "PASSED"
        },
        {
          "id": "TEST-015",
          "name": "Relaciones de agile_intakes",
          "relations": [
            "belongs to agileProjects",
            "belongs to agileStates (optional, suggestedState)",
            "belongs to agileIssues (optional, createdIssue)"
          ],
          "status": "PASSED"
        }
      ]
    },
    "constraints_validation": {
      "name": "Validación de Constraints",
      "tests": [
        {
          "id": "TEST-016",
          "name": "ON DELETE behaviors correctos",
          "assertions": [
            "agile_states.project_id: ON DELETE CASCADE",
            "agile_issues.project_id: ON DELETE CASCADE",
            "agile_issues.state_id: ON DELETE RESTRICT",
            "agile_issues.cycle_id: ON DELETE SET NULL",
            "agile_comments.issue_id: ON DELETE CASCADE"
          ],
          "status": "PASSED"
        },
        {
          "id": "TEST-017",
          "name": "Índices únicos definidos",
          "assertions": [
            "agile_projects.identifier es único",
            "agile_issues.key es único",
            "agile_module_issues (moduleId, issueId) es único",
            "agile_issue_labels (issueId, labelId) es único"
          ],
          "status": "PASSED"
        }
      ]
    },
    "architecture_validation": {
      "name": "Validación de Arquitectura",
      "tests": [
        {
          "id": "TEST-018",
          "name": "Estados como Entidades de Primera Clase",
          "description": "agile_states es una tabla separada, no un enum en issues",
          "assertions": [
            "agile_states tiene FK a agile_projects",
            "agile_issues tiene stateId FK a agile_states",
            "agile_states tiene campo group para categorización"
          ],
          "status": "PASSED"
        },
        {
          "id": "TEST-019",
          "name": "Separación Cycles vs Modules",
          "description": "Tiempo y Alcance son entidades separadas",
          "assertions": [
            "agile_cycles existe para Sprints (tiempo)",
            "agile_modules existe para Épicas (alcance)",
            "agile_issues puede tener cycleId y moduleId"
          ],
          "status": "PASSED"
        },
        {
          "id": "TEST-020",
          "name": "Intake para IA implementado",
          "description": "Bandeja de entrada para triage antes de backlog",
          "assertions": [
            "agile_intakes existe",
            "tiene campo source para tracking (ai_agent)",
            "tiene status con valores pending/accepted/declined",
            "tiene FK opcional a createdIssue"
          ],
          "status": "PASSED"
        }
      ]
    }
  },
  "summary": {
    "total_tests": 20,
    "passed": 20,
    "failed": 0,
    "pending": 0,
    "coverage": "100%",
    "status": "ALL_TESTS_PASSED"
  }
}
