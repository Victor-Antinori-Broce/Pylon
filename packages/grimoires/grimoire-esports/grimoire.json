{
  "id": "grimoire-esports",
  "name": "Esports",
  "description": "Complete esports competitive ecosystem with players, teams, tournaments, and match tracking.",
  "version": "1.0.0",
  "type": "grimoire",
  "icon": "Trophy",
  "tables": [
    {
      "name": "esports_players",
      "label": "Players",
      "icon": "User",
      "description": "Esports player profiles with stats and social links"
    },
    {
      "name": "esports_teams",
      "label": "Teams",
      "icon": "Users",
      "description": "Esports team management with rosters"
    },
    {
      "name": "esports_players_to_teams",
      "label": "Team Roster Links",
      "icon": "Link",
      "readonly": true
    },
    {
      "name": "esports_tournaments",
      "label": "Tournaments",
      "icon": "Trophy",
      "description": "Tournament engine with bracket generation"
    },
    {
      "name": "esports_tournament_participants",
      "label": "Tournament Participants",
      "icon": "UserPlus",
      "readonly": true
    },
    {
      "name": "esports_matches",
      "label": "Matches",
      "icon": "Swords",
      "description": "Competitive match tracking with scores"
    }
  ],
  "admin": {
    "category": "esports",
    "defaultView": "grid"
  },
  "dependencies": {
    "grimoires": ["grimoire-games", "grimoire-media"],
    "core": ["auth"]
  }
}
