{
  "name": "@gremius/grimoire-esports",
  "version": "1.0.0",
  "description": "Complete esports competitive ecosystem with players, teams, tournaments, and matches",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "build": "pnpm exec tsc",
    "dev": "pnpm exec tsc --watch"
  },
  "keywords": [
    "gremius",
    "grimoire",
    "esports",
    "tournaments",
    "gaming"
  ],
  "author": "Gremius Team",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@gremius/shared": "workspace:*",
    "hono": "^4.7.0",
    "drizzle-orm": "^0.45.0"
  },
  "gremius": {
    "type": "grimoire",
    "id": "grimoire-esports",
    "category": "esports",
    "order": 15,
    "core": false,
    "defaultEnabled": false,
    "minVersion": "0.8.0"
  }
