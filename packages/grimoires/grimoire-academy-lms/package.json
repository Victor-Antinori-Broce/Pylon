{
  "name": "@gremius/grimoire-academy-lms",
  "version": "1.1.0",
  "description": "Academy LMS - Learning Management System para Gremius",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "import": "./index.ts",
      "types": "./index.ts"
    },
    "./schema": {
      "import": "./academy-lms.schema.ts",
      "types": "./academy-lms.schema.ts"
    },
    "./routes": {
      "import": "./academy-lms.routes.ts",
      "types": "./academy-lms.routes.ts"
    },
    "./services/pdf": {
      "import": "./services/pdf.service.ts",
      "types": "./services/pdf.service.ts"
    },
    "./services/excel": {
      "import": "./services/excel.service.ts",
      "types": "./services/excel.service.ts"
    },
    "./services/media": {
      "import": "./services/media.service.ts",
      "types": "./services/media.service.ts"
    },
    "./services/user-sync": {
      "import": "./services/user-sync.service.ts",
      "types": "./services/user-sync.service.ts"
