{
  "id": "grimoire-conta",
  "name": "Contabilidad",
  "description": "Motor de Libro Mayor General (General Ledger Engine) con partida doble, multidivisa, plantillas de asientos, metadata JSONB y soporte para contabilidad legal.",
  "version": "1.0.0",
  "type": "grimoire",
  "icon": "Landmark",
  "tables": [
    {
      "name": "conta_currencies",
      "label": "Monedas",
      "icon": "Coins",
      "description": "Tabla de monedas para soporte multidivisa"
    },
    {
      "name": "conta_accounts",
      "label": "Cuentas",
      "icon": "BookOpen",
      "description": "Plan de cuentas contable jerárquico",
      "searchableFields": ["code", "name"],
      "filterableFields": ["type", "isActive", "isTrustAccount"]
    },
    {
      "name": "conta_counterparties",
      "label": "Terceros",
      "icon": "Users",
      "description": "Clientes, proveedores, bancos y otros terceros",
      "searchableFields": ["name", "taxId"],
      "filterableFields": ["type"]
    },
    {
      "name": "conta_matters",
      "label": "Expedientes",
      "icon": "Briefcase",
      "description": "Casos legales o proyectos para trazabilidad",
      "searchableFields": ["name", "matterNumber"],
      "filterableFields": ["status", "clientId"]
    },
    {
      "name": "conta_journal_templates",
      "label": "Plantillas",
      "icon": "FileStack",
      "description": "Plantillas de asientos contables para eventos de negocio",
      "searchableFields": ["name", "templateType"],
      "filterableFields": ["templateType", "isActive"]
    },
    {
      "name": "conta_journals",
      "label": "Asientos",
      "icon": "FileText",
      "description": "Encabezados de asientos contables (Journal Entries)",
      "searchableFields": ["description", "reference"],
      "filterableFields": ["status", "journalType", "date"]
    },
    {
      "name": "conta_ledger_entries",
      "label": "Líneas de Mayor",
      "icon": "Scale",
      "description": "Líneas de partida doble del Libro Mayor",
      "searchableFields": ["description"],
      "filterableFields": ["accountId", "matterId", "currency"]
    },
    {
      "name": "conta_disbursements",
      "label": "Gastos Reembolsables",
      "icon": "Receipt",
      "description": "Disbursements y gastos recuperables de clientes",
      "searchableFields": ["description"],
      "filterableFields": ["status", "matterId"]
    }
  ],
  "dependencies": {
    "grimoires": [],
    "core": ["auth"]
  },
  "admin": {
    "category": "data",
    "defaultView": "accounts",
    "views": [
      {
        "id": "accounts",
        "type": "grid",
        "title": "Cuentas",
        "table": "conta_accounts"
      },
      {
        "id": "journals",
        "type": "grid",
        "title": "Asientos",
        "table": "conta_journals"
      },
      {
        "id": "ledger",
        "type": "grid",
        "title": "Líneas de Mayor",
        "table": "conta_ledger_entries"
      },
      {
        "id": "matters",
        "type": "grid",
        "title": "Expedientes",
        "table": "conta_matters"
      },
      {
        "id": "templates",
        "type": "grid",
        "title": "Plantillas",
        "table": "conta_journal_templates"
      },
      {
        "id": "journal-form",
        "type": "custom",
        "title": "Nuevo Asiento"
      },
      {
        "id": "reports",
        "type": "custom",
        "title": "Reportes"
      },
      {
        "id": "disbursement-form",
        "type": "custom",
        "title": "Gastos Reembolsables"
      },
      {
        "id": "template-form",
        "type": "custom",
        "title": "Nueva Plantilla"
      }
    ]
  }
}
