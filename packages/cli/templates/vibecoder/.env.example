# ═══════════════════════════════════════════════════════════════════════════
# GremiusCMS — Environment Configuration
# Copy to .env and customize (or leave defaults for local dev)
# ═══════════════════════════════════════════════════════════════════════════

PROJECT_NAME=my-gremius-app

# --- Database ---
POSTGRES_USER=gremius
POSTGRES_PASSWORD=gremiuspassword
POSTGRES_DB=gremius
DB_PORT=5432

# --- Cache ---
CACHE_PORT=6379

# --- API ---
API_PORT=3000
BETTER_AUTH_SECRET=dev-secret-change-in-production-min-32-chars

# --- Admin ---
ADMIN_PORT=3001

# --- Storage (MinIO) ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ACCESS_KEY=gremius_minio
S3_SECRET_KEY=gremius_minio_secret
S3_BUCKET=gremius-media
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000

# --- Features ---
ENABLE_SWAGGER=true
ENABLE_MCP=true
