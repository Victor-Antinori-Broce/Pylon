# ===================================================================
# GremiusCMS - Dockerfile de PRODUCCION (Multi-Stage Optimizado)
#
# Construye:
#   - API (Bun runtime)
#   - Admin (SvelteKit static + nginx)
#
# USO:
#   docker build -f docker/Dockerfile.prod --target api -t gremius-api:latest .
#   docker build -f docker/Dockerfile.prod --target admin -t gremius-admin:latest .
#
# OPTIMIZACIONES:
#   - Sharp se compila en builder (no en la imagen final)
#   - Pruning de archivos innecesarios antes de copiar a runtime
#   - Sin dependencias de build en imagen final (python3, make, g++)
# ===================================================================

# ===================================================================
# STAGE 1: Base con pnpm
# ===================================================================
FROM oven/bun:1-alpine AS base
RUN apk add --no-cache nodejs npm
WORKDIR /app
RUN npm install -g pnpm@9.15.4

# ===================================================================
# STAGE 2: Dependencies - Instala todas las dependencias
# ===================================================================
FROM base AS dependencies

# Copiar archivos de configuracion del monorepo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copiar package.json de cada workspace package
COPY apps/api/package.json ./apps/api/
COPY apps/admin/package.json ./apps/admin/
COPY packages/shared/package.json ./packages/shared/
COPY packages/mcp-server/package.json ./packages/mcp-server/
COPY packages/sdk/package.json ./packages/sdk/
COPY packages/engine/package.json ./packages/engine/
COPY packages/core/package.json ./packages/core/
COPY packages/grimoires/package.json ./packages/grimoires/
COPY packages/grimoires/grimoire-academy-lms/package.json ./packages/grimoires/grimoire-academy-lms/
COPY packages/grimoires/grimoire-datasets/package.json ./packages/grimoires/grimoire-datasets/
COPY packages/grimoires/grimoire-media/package.json ./packages/grimoires/grimoire-media/
COPY packages/grimoires/grimoire-blog/package.json ./packages/grimoires/grimoire-blog/
COPY packages/grimoires/grimoire-booking/package.json ./packages/grimoires/grimoire-booking/
COPY packages/realms/package.json ./packages/realms/

# Copiar starter template package.json (si existe, no falla si no)
COPY packages/starters/gremio-blog-template/package.json ./packages/starters/gremio-blog-template/

# Instalar dependencias con lockfile estricto
# Si falla, ejecutar localmente: pnpm install && git add pnpm-lock.yaml && git commit
RUN pnpm install --frozen-lockfile || pnpm install --no-frozen-lockfile

# ===================================================================
# STAGE 3: Builder - Compila el codigo y Sharp
# ===================================================================
FROM dependencies AS builder

# Herramientas de build para compilar sharp (solo en builder)
RUN apk add --no-cache python3 make g++

# API URL for the admin frontend (build-time variable)
# In production with nginx proxy: empty string (relative /api/* calls)
# The admin nginx proxies /api/* to the API container internally.
ARG PUBLIC_API_URL=""
ENV PUBLIC_API_URL=${PUBLIC_API_URL}
ENV VITE_API_URL=${PUBLIC_API_URL}

# Copiar todo el codigo fuente
COPY . .

# Compilar shared (requerido por todos)
RUN pnpm --filter @gremius/shared build

# Compilar API
RUN pnpm --filter @gremius/api build

# Clean any generated .js files that might conflict with .ts files
RUN find apps/admin/src -name "+layout.js" -type f -delete 2>/dev/null || true

# Compilar Admin
RUN pnpm --filter @gremius/admin build

# Recompilar sharp para Alpine/musl en el builder
RUN SHARP_IGNORE_GLOBAL_LIBVIPS=1 pnpm rebuild sharp

# Prune: eliminar archivos innecesarios para runtime
# Esto reduce significativamente el tamano de la imagen final
RUN rm -rf \
    **/*.md \
    **/tests \
    **/test-results \
    **/playwright-report \
    **/*.test.ts \
    **/docs \
    **/.vscode \
    **/.claude \
    **/specs \
    **/Pylon \
    **/pylon1 \
    apps/admin/src \
    apps/admin/node_modules \
    apps/admin/.svelte-kit \
    apps/admin/static

# ===================================================================
# STAGE 4: API - Backend de produccion
# ===================================================================
FROM oven/bun:1-alpine AS api
WORKDIR /app

# SOLO postgresql-client (necesario para start-with-check.sh)
RUN apk add --no-cache postgresql-client

# Copy the pruned workspace from builder
# Bun runs .ts natively - dynamic imports (grimoires, core, engine)
# and pnpm symlinks must resolve correctly
COPY --from=builder /app /app

# Variables de entorno por defecto
ENV NODE_ENV=production
ENV PORT=3000
ENV GREMIUS_AUTO_SETUP=true

EXPOSE 3000

# Healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1

# Run startup script with pgvector check and migrations
WORKDIR /app
CMD ["sh", "/app/docker/start-with-check.sh"]

# ===================================================================
# STAGE 5: Admin - Frontend estatico servido por nginx
# ===================================================================
FROM nginx:alpine AS admin

# Copiar archivos estaticos construidos
COPY --from=builder /app/apps/admin/build /usr/share/nginx/html

# Copiar configuracion de nginx
COPY docker/nginx-admin.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
