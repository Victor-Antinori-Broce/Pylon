{
  "name": "@kitsuden/codegen",
  "version": "0.9.0-beta",
  "description": "Frontend code generation for Kitsuden collections",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/generators/react.ts",
    "./vue": "./src/generators/vue.ts",
    "./svelte": "./src/generators/svelte.ts",
    "./generators/types": "./src/generators/types.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsup": "^8.0.0"
  }
}
