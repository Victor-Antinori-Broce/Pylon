{
  "name": "@gremius/codegen",
  "version": "0.1.0",
  "description": "Frontend code generation for Gremius collections",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/generators/react.ts",
    "./vue": "./src/generators/vue.ts",
    "./svelte": "./src/generators/svelte.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsup": "^8.0.0"
  }
}
