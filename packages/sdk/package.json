{
  "name": "@kitsuden/sdk",
  "version": "0.9.0-beta",
  "description": "Kitsuden Universal SDK — CRUD in 3 lines. Edge-ready. Type-safe.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./realtime": {
      "import": {
        "types": "./dist/realtime/realtime.d.ts",
        "default": "./dist/realtime/realtime.js"
      },
      "require": {
        "types": "./dist/realtime/realtime.d.cts",
        "default": "./dist/realtime/realtime.cjs"
      }
    },
    "./rpc": {
      "import": {
        "types": "./dist/rpc/rpc.d.ts",
        "default": "./dist/rpc/rpc.js"
      },
      "require": {
        "types": "./dist/rpc/rpc.d.cts",
        "default": "./dist/rpc/rpc.cjs"
      }
    },
    "./toon-protocol": {
      "import": {
        "types": "./dist/toon-protocol/toon-protocol.d.ts",
        "default": "./dist/toon-protocol/toon-protocol.js"
      },
      "require": {
        "types": "./dist/toon-protocol/toon-protocol.d.cts",
        "default": "./dist/toon-protocol/toon-protocol.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "hono": "^4.12.3",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "kitsuden",
    "cms",
    "baas",
    "sdk",
    "typescript",
    "edge",
    "serverless",
    "realtime",
    "websocket"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "hono": "^4.7.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  }
}
