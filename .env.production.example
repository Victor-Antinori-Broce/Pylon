# ===================================================================
# Kitsuden - Production Environment Variables
# ===================================================================
# Copia este archivo a .env y rellena con tus valores reales.
# NUNCA subas .env a git.
# ===================================================================

# Database (PostgreSQL 16 + pgvector)
POSTGRES_USER=kitsuden
POSTGRES_PASSWORD=<CHANGE_ME_POSTGRES_PASSWORD>
POSTGRES_DB=kitsuden_prod
DATABASE_URL=postgresql://kitsuden:<CHANGE_ME_POSTGRES_PASSWORD>@localhost:5432/kitsuden_prod

# Redis / Valkey
REDIS_URL=redis://localhost:6379

# API Server
API_PORT=3000
PORT=3000
NODE_ENV=production
PUBLIC_API_URL=http://localhost:3000

# Better-Auth (REQUERIDO: mínimo 32 caracteres)
# Genera uno nuevo con: openssl rand -base64 32
BETTER_AUTH_SECRET=<GENERATE_A_SECURE_SECRET_MIN_32_CHARS>
# Con el overlay TLS se deriva de KITSUDEN_DOMAIN y esta linea se ignora.
BETTER_AUTH_URL=https://cms.example.com

# Admin Panel
ADMIN_URL=https://cms.example.com

# Sitio publico (el frontend). Cada wiki se sirve en <wiki>.<este dominio>
# (p. ej. throne-and-liberty.example.com) y cada juego en /<juego>/.
# Necesita un registro DNS comodin (*.example.com) apuntando a esta maquina.
# Si el panel es un subdominio de este mismo dominio (cms.example.com), kon-wiki
# impide crear una wiki con ese nombre.
SITE_URL=https://example.com
ADMIN_PORT=3001

# Site Info
PUBLIC_SITE_NAME=Kitsuden

# Storage: usa 'local' para desarrollo, 'minio' o 's3' para producción
DEFAULT_STORAGE_PROVIDER=local

# MinIO / S3 (solo si DEFAULT_STORAGE_PROVIDER=minio o s3)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET=kitsuden-media
S3_REGION=us-east-1
S3_ACCESS_KEY=<CHANGE_ME_MINIO_ACCESS_KEY>
S3_SECRET_KEY=<CHANGE_ME_MINIO_SECRET_KEY>

# CORS
ALLOWED_ORIGINS=https://cms.example.com

# Features
RATE_LIMIT_ENABLED=true
# Clave compartida entre la API y el servidor del sitio público. Con ella la
# API cuenta el límite de peticiones por VISITANTE; sin ella, todas las visitas
# del sitio son un solo cliente y a las 300 páginas/min la web empieza a fallar.
# Genérala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SITIO_API_CLAVE=
LOG_LEVEL=info
ENABLE_SWAGGER=true
ENABLE_MCP=true
HEADLESS=false

# OAuth Opcional (descomenta y configura si los usas)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=common
# Redirect a registrar en Discord: <BETTER_AUTH_URL>/api/auth/callback/discord
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Seed Passwords (opcional — si no se definen, se generan aleatorias)
# ADMIN_SEED_PASSWORD=
# USER_SEED_PASSWORD=

# Docker Compose Overrides (opcional)
# KITSUDEN_API_IMAGE=kitsuden/api:latest
# KITSUDEN_ADMIN_IMAGE=kitsuden/admin:latest
# DB_PORT=5432
# VALKEY_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001


# --- KITSUDEN Secrets Manager (arquitectura KITSUDEN §7) ---
# Clave maestra para cifrar secrets en la tabla kitsuden_secrets (AES-256-GCM).
# Si no se define, se deriva de BETTER_AUTH_SECRET (solo aceptable en dev).
KITSUDEN_SECRETS_KEY=<GENERATE_A_SECURE_SECRET_MIN_32_CHARS>

# --- KITSUDEN Vault (arquitectura KITSUDEN §3) ---
# Habilita esquemas dinámicos con CREATE/ALTER TABLE reales + RLS automático.
# Opt-in: coexiste con el Dataset Engine JSONB (ADR-001).
KITSUDEN_VAULT_ENABLED=false

# ── Rol de aplicacion (RLS) ──────────────────────────────────────────────────
# La API NO debe conectarse como superusuario: Postgres ignora las politicas RLS
# para superusuarios, asi que el aislamiento entre tenants queda decorativo.
# POSTGRES_USER/POSTGRES_PASSWORD siguen siendo el superusuario, y se usan solo
# para migrar. Estas dos son la cuenta con la que corre la API; el rol se crea
# solo en el arranque con los permisos justos.
APP_DB_USER=kitsuden_app
APP_DB_PASSWORD=cambiame-en-produccion

# ═══════════════════════════════════════════════════════════════════════════
# PRODUCCION PUBLICA — overlay TLS
#
#   docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d
#
# El overlay activa KITSUDEN_PUBLIC=true y el arranque ABORTA si falta algo de
# este bloque: una URL en localhost, un correo que iria a la consola o un
# secreto corto no dan error al arrancar, fallan despues delante de un usuario.
# ═══════════════════════════════════════════════════════════════════════════

# Dominio con su registro DNS apuntando a este servidor (puertos 80 y 443).
KITSUDEN_DOMAIN=cms.example.com
# Recibe los avisos de caducidad de Let's Encrypt.
ACME_EMAIL=ops@example.com

# ── Correo (obligatorio en modo publico) ────────────────────────────────────
# Sin transporte, la verificacion de email y la recuperacion de contrasena no
# llegan a nadie. Basta UNO de los dos.
RESEND_API_KEY=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# Con un dominio real: los proveedores rechazan o marcan como spam @localhost.
MAIL_FROM=Kitsuden <noreply@example.com>

# ── Red ─────────────────────────────────────────────────────────────────────
# Por defecto todo escucha en 127.0.0.1 y solo Caddy (80/443) es publico.
# Poner 0.0.0.0 expone Postgres, Valkey y la API SIN TLS: que sea a proposito.
# BIND_ADDRESS=127.0.0.1

# ── Backups ─────────────────────────────────────────────────────────────────
# Se hacen solos en el contenedor kitsuden_backup, al arrancar y cada intervalo.
# Quedan en el volumen kitsuden_backups_prod, EN ESTA MISMA MAQUINA: sacalos a
# otro sitio para sobrevivir a la perdida del servidor.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
