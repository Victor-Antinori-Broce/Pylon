# ===================================================================
# Kitsuden — variables de PRODUCCIÓN (servidor con Docker)
#
# ¿Solo quieres probarlo en tu máquina? ./install.sh (o install.ps1) crea este
# fichero por ti. Lo de abajo es para un servidor con dominio.
#
#   cp .env.production.example .env   y rellena los <...>
#   ./scripts/deploy.sh               (o: docker compose -f docker-compose.yml
#                                      -f docker-compose.tls.yml up -d --build)
#
# Guía: docs/install/server.md (inglés) · docs/instalacion/servidor.md
# Cada variable explicada: docs/install/variables.md · docs/instalacion/variables.md
#
# NUNCA subas .env a git (está en .gitignore). Genera cada secreto con:
#   openssl rand -hex 32
# y no los pegues en scripts sueltos.
#
# Solo están las variables que de verdad leen docker-compose.yml,
# docker-compose.tls.yml y scripts/deploy.sh: las URLs de conexión
# (DATABASE_URL, REDIS_URL…) las arma el propio compose.
#
# Un valor que EMPIEZA por «<» es un hueco por rellenar: scripts/deploy.sh se
# niega a seguir mientras quede alguno. Sin dominio (solo docker-compose.yml),
# borra o vacía las líneas de dominio y correo.
# ===================================================================

# Nombre del proyecto de compose: prefijo del volumen de medios
# (<proyecto>_kitsuden_uploads_prod). Fíjalo para que no dependa del nombre
# de la carpeta.
COMPOSE_PROJECT_NAME=kitsuden

# ── Base de datos (PostgreSQL 16 + pgvector) ──────────────────────────────
# Superusuario: solo migra, crea el rol de la app y hace las copias. La imagen
# de Postgres lo crea SOLO la primera vez (volumen vacío): cambiarlo después no
# cambia la base.
POSTGRES_USER=kitsuden
POSTGRES_PASSWORD=<openssl rand -hex 32>
POSTGRES_DB=kitsuden_prod

# Rol con el que corre la API (RLS: un superusuario se salta las políticas).
# Se crea solo en el arranque.
APP_DB_USER=kitsuden_app
APP_DB_PASSWORD=<openssl rand -hex 32>

# Rol limitado para crear tablas en caliente (activar kons desde el panel, el
# Vault). Se crea solo en el arranque. Sin él, activar un kon falla: la URL de
# admin se retira antes de lanzar la API.
DDL_DB_PASSWORD=<openssl rand -hex 32>

# ── Secretos de la aplicación ─────────────────────────────────────────────
# Mínimo 32 caracteres (la API no arranca con uno más corto)
BETTER_AUTH_SECRET=<openssl rand -hex 32>
# Cifra los secretos guardados en la base. Sin ella se deriva de
# BETTER_AUTH_SECRET (solo aceptable en desarrollo). Perderla = perder esos
# secretos: guárdala con las copias.
KITSUDEN_SECRETS_KEY=<openssl rand -hex 32>
# La comparten la API y la web (en la web: KITSUDEN_SITE_KEY; el overlay TLS
# se la pasa). Con ella el límite de peticiones se cuenta por VISITANTE; sin
# ella, todo el sitio es un solo cliente. Obligatoria con el overlay TLS.
SITIO_API_CLAVE=<openssl rand -hex 32>

# ── Dominios (docker-compose.tls.yml + docker/Caddyfile) ──────────────────
# Registros DNS A a la IP del servidor: SITE_DOMAIN, www.SITE_DOMAIN y
# KITSUDEN_DOMAIN. Puertos 80 y 443 abiertos.
SITE_DOMAIN=<ejemplo.com>
# El panel, y la API que usa el navegador (su nginx reenvía /api/*).
# Vacío = panel.<SITE_DOMAIN>
KITSUDEN_DOMAIN=
# Avisos de caducidad de Let's Encrypt
ACME_EMAIL=<ops@ejemplo.com>

# ── Correo (OBLIGATORIO en modo público: sin él la API no arranca) ────────
# Basta UNO de los dos transportes.
RESEND_API_KEY=
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# Fuerza un driver (resend | smtp | log). Vacío = Resend si hay clave, SMTP si
# hay host.
# MAIL_DRIVER=
# Con el dominio real: los proveedores rechazan o marcan como spam @localhost.
# Formato «Nombre <correo>», p. ej. Mi sitio <noreply@ejemplo.com>
MAIL_FROM=<Nombre <noreply@ejemplo.com>>

# ── La web pública (kitsuden_web: el starter neutro) ──────────────────────
# Se GRABAN al compilar la web: cambiarlas exige
# `docker compose -f docker-compose.yml -f docker-compose.tls.yml build kitsuden_web`.
SITE_NAME=Kitsuden
SITE_LOCALE=en
# Zona horaria de la web (API, base y copias van siempre en UTC)
TZ=UTC

# Rutas de primer nivel de TU web que un juego (kon-games) no puede tomar como
# slug, separadas por comas. Se suman a las comunes de
# packages/shared/src/sitio-publico.ts (blog, api, media, img, legal…).
# KITSUDEN_SEGMENTOS_RESERVADOS=torneos,tienda

# Overlays de compose propios (otra web en lugar del starter, servicios
# extra), separados por comas. Solo los lee scripts/deploy.sh, que los añade
# DESPUÉS de docker-compose.tls.yml.
# KITSUDEN_OVERLAYS=docker-compose.miweb.yml

# ── Almacenamiento ────────────────────────────────────────────────────────
# `local` = volumen de la API (/app/data, servido en /media).
# `s3` = almacenamiento S3: entonces S3_ACCESS_KEY y S3_SECRET_KEY son
# obligatorias (con `local` no hacen falta).
DEFAULT_STORAGE_PROVIDER=local
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=kitsuden-media
# S3_REGION=us-east-1
# S3_PUBLIC_URL=

# ── Copias ────────────────────────────────────────────────────────────────
# Base: pg_dump cada BACKUP_INTERVAL_HOURS, se guardan BACKUP_KEEP
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# Medios: copia completa cada BACKUP_MEDIA_DIAS días, se guardan
# BACKUP_MEDIA_KEEP. Todo queda en el volumen kitsuden_backups_prod del MISMO
# disco: sácalo fuera para sobrevivir a perder el servidor.
BACKUP_MEDIA_DIAS=7
BACKUP_MEDIA_KEEP=2

# ── Varios ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Documentación interactiva de la API en /api/docs (el overlay TLS la apaga
# salvo que la pidas)
ENABLE_SWAGGER=false
# Acciones de código: el JS (de un admin o de un agente) corre en QuickJS
# (WebAssembly) dentro de un proceso hijo sin entorno y con node --permission:
# sin ficheros, sin red salvo la lista blanca, sin secretos; la API de Kitsuden
# solo con los scopes que declare la acción. Ver docs/agents/sandbox.md.
# Apagadas salvo que hagan falta.
ENABLE_CODE_ACTIONS=false
# Hosts a los que el código puede hacer fetch (además de config.fetchAllow).
# KITSUDEN_SANDBOX_FETCH_ALLOW=api.example.com,*.example.org
# Vault: colecciones con CREATE TABLE reales. Apagado de serie a propósito.
# KITSUDEN_VAULT_ENABLED=false

# Por defecto todo escucha en 127.0.0.1 y solo Caddy (80/443) es público.
# 0.0.0.0 expondría Postgres, Valkey y la API SIN TLS (y Docker se salta ufw).
# BIND_ADDRESS=127.0.0.1
# Puertos del host (todos en BIND_ADDRESS)
# API_PORT=3000
# ADMIN_PORT=3001
# DB_PORT=5432
# VALKEY_PORT=6379

# Segunda instalación en la misma máquina: cambia el prefijo de contenedores,
# volúmenes y red (por defecto `kitsuden`), para que no comparta datos con la
# primera. install.sh lo elige solo. No lo cambies en una instalación con datos:
# apuntaría a volúmenes vacíos.
# KITSUDEN_INSTANCE=kitsuden

# Nombres de las imágenes (por defecto kitsuden/api:latest, kitsuden/admin:latest,
# kitsuden/web:latest). Útil para una segunda instalación en la misma máquina.
# KITSUDEN_API_IMAGE=
# KITSUDEN_ADMIN_IMAGE=
# KITSUDEN_WEB_IMAGE=

# OAuth (GitHub/Google/Discord): docker-compose.yml HOY no pasa esas variables
# al contenedor de la API. Si se quieren, hay que añadirlas a su
# `environment:` con un overlay.

# kon-payments: ids de plan/precio/variante que se pueden contratar, separados
# por comas. En producción, sin esta lista no se vende nada (auditoría
# 2026-10-25: cualquier precio de la cuenta del comercio daba acceso).
# PAYMENTS_ALLOWED_PLANS=price_123,price_456

# --- OAuth for MCP clients (docs/agents/oauth.md) ---
# Public https origin of the API (no path). Required for Claude/Cursor to
# connect with OAuth; with a non-https value OAuth stays off in production.
# ADMIN_URL must be the panel's public URL (the consent screen lives there).
# Empty = BETTER_AUTH_URL, which docker-compose.tls.yml derives from your domain.
# OAUTH_ISSUER_URL=https://api.example.com
