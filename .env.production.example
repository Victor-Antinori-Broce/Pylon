# ===================================================================
# GremiusCMS - Production Environment Variables
# ===================================================================
# Copia este archivo a .env y rellena con tus valores reales.
# NUNCA subas .env a git.
# ===================================================================

# ───────────────────────────────────────────────────────────────────
# Database (PostgreSQL 16 + pgvector)
# ───────────────────────────────────────────────────────────────────
POSTGRES_USER=gremius
POSTGRES_PASSWORD=cambia_esta_password_segura_123
POSTGRES_DB=gremius_prod
DATABASE_URL=postgresql://gremius:cambia_esta_password_segura_123@localhost:5432/gremius_prod

# ───────────────────────────────────────────────────────────────────
# Redis / Valkey
# ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ───────────────────────────────────────────────────────────────────
# API Server
# ───────────────────────────────────────────────────────────────────
API_PORT=3000
PORT=3000
NODE_ENV=production
PUBLIC_API_URL=http://localhost:3000

# ───────────────────────────────────────────────────────────────────
# Better-Auth (REQUERIDO: mínimo 32 caracteres)
# Genera uno nuevo con: openssl rand -base64 32
# ───────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=cambia_esto_por_un_secreto_largo_de_al_menos_32_caracteres
BETTER_AUTH_URL=http://localhost:3000

# ───────────────────────────────────────────────────────────────────
# Admin Panel
# ───────────────────────────────────────────────────────────────────
ADMIN_URL=http://localhost:3001
ADMIN_PORT=3001

# ───────────────────────────────────────────────────────────────────
# Site Info
# ───────────────────────────────────────────────────────────────────
PUBLIC_SITE_NAME=GremiusCMS

# ───────────────────────────────────────────────────────────────────
# Storage: usa 'local' para desarrollo, 'minio' o 's3' para producción
# ───────────────────────────────────────────────────────────────────
DEFAULT_STORAGE_PROVIDER=local

# MinIO / S3 (solo si DEFAULT_STORAGE_PROVIDER=minio o s3)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET=gremius-media
S3_REGION=us-east-1
S3_ACCESS_KEY=gremius_minio
S3_SECRET_KEY=gremius_minio_secret_2025

# ───────────────────────────────────────────────────────────────────
# CORS
# ───────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ───────────────────────────────────────────────────────────────────
# Features
# ───────────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info
ENABLE_SWAGGER=true
ENABLE_MCP=true
HEADLESS=false

# ───────────────────────────────────────────────────────────────────
# OAuth Opcional (descomenta y configura si los usas)
# ───────────────────────────────────────────────────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=common

# ───────────────────────────────────────────────────────────────────
# Seed Passwords (opcional — si no se definen, se generan aleatorias)
# ───────────────────────────────────────────────────────────────────
# ADMIN_SEED_PASSWORD=
# USER_SEED_PASSWORD=

# ───────────────────────────────────────────────────────────────────
# Docker Compose Overrides (opcional)
# ───────────────────────────────────────────────────────────────────
# GREMIUS_API_IMAGE=gremius/api:latest
# GREMIUS_ADMIN_IMAGE=gremius/admin:latest
# DB_PORT=5432
# VALKEY_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
