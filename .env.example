# ===================================================================
# Kitsuden - Environment Configuration
# Copy this file to .env and update the values for your environment
# NEVER commit .env to git.
# ===================================================================

# --- Database ---
# ⚠️ RLS solo aplica si la app se conecta como rol NO-superusuario. El usuario
# que crea la imagen oficial de Postgres ES superusuario: vale para desarrollo,
# pero en producción crea un rol aparte (ver apps/api/docs/RLS_SETUP_GUIDE.md).
POSTGRES_USER=kitsuden
POSTGRES_PASSWORD=<CHANGE_ME_POSTGRES_PASSWORD>
POSTGRES_DB=kitsuden_dev
DATABASE_URL=postgres://kitsuden:<CHANGE_ME_POSTGRES_PASSWORD>@localhost:5432/kitsuden_dev

# --- Valkey/Redis ---
REDIS_URL=redis://localhost:6379

# --- Server ---
# API runs on 3000 in Docker/production and by default in dev.
# Admin dev server (Vite) runs on ADMIN_PORT below.
API_PORT=3000
PORT=3000
NODE_ENV=development

# --- Authentication ---
# IMPORTANT: Change to a secure random string in production (min 32 chars)
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=<GENERATE_A_SECURE_SECRET_MIN_32_CHARS>
BETTER_AUTH_URL=http://localhost:3001

# --- URLs ---
# Admin dev server (Vite). In Docker/production the admin panel is served on port 3001.
ADMIN_URL=http://localhost:5173
ADMIN_PORT=5173
PUBLIC_API_URL=http://localhost:3000
PUBLIC_SITE_NAME=Kitsuden

# --- Storage (S3/MinIO) ---
DEFAULT_STORAGE_PROVIDER=local
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET=kitsuden-media
S3_REGION=us-east-1
S3_ACCESS_KEY=<CHANGE_ME_MINIO_ACCESS_KEY>
S3_SECRET_KEY=<CHANGE_ME_MINIO_SECRET_KEY>

# --- CORS ---
# CORS con credenciales: si un origen no esta aqui, los comentarios y la sesion
# fallan desde ese sitio (y fallan SOLO al interactuar: la pagina carga bien).
# Va una entrada por WEB publica, mas el panel. Los subdominios del sitio
# principal (wikis, esports) los resuelve origenes-cors.ts, no hacen falta aqui.
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:5173,http://localhost:3001

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
# Clave compartida entre la API y el servidor del sitio público. Con ella la
# API cuenta el límite de peticiones por VISITANTE; sin ella, todas las visitas
# del sitio son un solo cliente y a las 300 páginas/min la web empieza a fallar.
# Genérala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SITIO_API_CLAVE=

# --- Logging ---
LOG_LEVEL=info

# --- Feature Flags ---
ENABLE_SWAGGER=true
ENABLE_MCP=true

# --- Headless Mode (BaaS-only, no admin UI) ---
HEADLESS=false

# --- OAuth Providers (optional) ---
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=
# Discord - la identidad del publico de gaming/esports.
# App en https://discord.com/developers/applications; redirect a registrar:
#   <BETTER_AUTH_URL>/api/auth/callback/discord
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# --- SMTP (optional) ---
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=

# ═══════════════════════════════════════════════════════════════════
# LLM Providers (Agents Engine)
# ═══════════════════════════════════════════════════════════════════
# Configure at least one provider. The Agent Engine picks the first
# available in this order: OpenAI > Anthropic > DeepSeek > Ollama.
# You can override the default model with KITSUDEN_LLM_PROVIDER + KITSUDEN_LLM_MODEL.

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat

# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Optional: force a specific provider/model
# KITSUDEN_LLM_PROVIDER=openai
# KITSUDEN_LLM_MODEL=gpt-4o


# --- KITSUDEN Secrets Manager (arquitectura KITSUDEN §7) ---
# Clave maestra para cifrar secrets en la tabla kitsuden_secrets (AES-256-GCM).
# Si no se define, se deriva de BETTER_AUTH_SECRET (solo aceptable en dev).
KITSUDEN_SECRETS_KEY=<GENERATE_A_SECURE_SECRET_MIN_32_CHARS>

# --- KITSUDEN Vault (arquitectura KITSUDEN §3) ---
# Habilita esquemas dinámicos con CREATE/ALTER TABLE reales + RLS automático.
# Opt-in: coexiste con el Dataset Engine JSONB (ADR-001).
KITSUDEN_VAULT_ENABLED=false

# ── Rol de aplicacion (RLS) ──────────────────────────────────────────────────
# La API NO debe conectarse como superusuario: Postgres ignora las politicas RLS
# para superusuarios, asi que el aislamiento entre tenants queda decorativo.
# POSTGRES_USER/POSTGRES_PASSWORD siguen siendo el superusuario, y se usan solo
# para migrar. Estas dos son la cuenta con la que corre la API; el rol se crea
# solo en el arranque con los permisos justos.
APP_DB_USER=kitsuden_app
APP_DB_PASSWORD=cambiame-en-produccion
