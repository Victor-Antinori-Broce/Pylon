# ===================================================================
# GremiusCMS - Environment Configuration
# Copy this file to .env and update the values for your environment
# ===================================================================

# --- Database ---
POSTGRES_USER=gremius
POSTGRES_PASSWORD=gremiuspassword
POSTGRES_DB=gremius_dev
DATABASE_URL=postgres://gremius:gremiuspassword@localhost:5432/gremius_dev

# --- Valkey/Redis ---
REDIS_URL=redis://localhost:6379

# --- Server ---
API_PORT=3001
PORT=3001
NODE_ENV=development

# --- Authentication ---
# IMPORTANT: Change to a secure random string in production (min 32 chars)
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-better-auth-secret-gremiuscms-change-in-production-32
BETTER_AUTH_URL=http://localhost:3001

# --- URLs ---
ADMIN_URL=http://localhost:5173
ADMIN_PORT=5173
PUBLIC_API_URL=http://localhost:3001
PUBLIC_SITE_NAME=GremiusCMS

# --- Storage (S3/MinIO) ---
DEFAULT_STORAGE_PROVIDER=local
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET=gremius-media
S3_REGION=us-east-1
S3_ACCESS_KEY=gremius_minio
S3_SECRET_KEY=gremius_minio_secret_2025

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true

# --- Logging ---
LOG_LEVEL=info

# --- Feature Flags ---
ENABLE_SWAGGER=true
ENABLE_MCP=true

# --- Headless Mode (BaaS-only, no admin UI) ---
HEADLESS=false

# --- OAuth Providers (optional) ---
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=

# --- SMTP (optional) ---
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
